<Window x:Class="PuntoDeVentaLibreria.UI.Views.Caja.GastoRetiroModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Movimiento de Caja" 
        Height="360" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TxtTitulo" Text="REGISTRAR MOVIMIENTO" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="Se descontará del efectivo disponible en el mostrador" FontSize="12" Foreground="#64748B"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Monto en Efectivo ($):" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtMonto" FontSize="20" FontWeight="Bold" Padding="8,6" Margin="0,0,0,12"/>

            <TextBlock Text="Concepto / Motivo:" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtConcepto" FontSize="14" Padding="8,6"/>
        </StackPanel>

        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <Button Content="Cancelar" Click="BtnCancelar_Click" Padding="16,8" FontSize="13" Cursor="Hand"/>
            <Button x:Name="BtnConfirmar" Content="Confirmar Egreso" Click="BtnConfirmar_Click" HorizontalAlignment="Right"
                    Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="20,8" FontSize="13" Cursor="Hand"/>
        </DockPanel>
    </Grid>
</Window>
