<Window x:Class="PuntoDeVentaLibreria.UI.Views.Pos.SeleccionarVarianteModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Seleccionar Color / Variante" 
        Height="420" Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Border Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock x:Name="TxtTituloArticulo" Text="Cuaderno Universitario 80h" FontSize="18" FontWeight="Bold" Foreground="#0F172A" DockPanel.Dock="Left"/>
                    <Border DockPanel.Dock="Right" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="12" Padding="10,4">
                        <TextBlock x:Name="TxtPrecioVenta" Text="$ 1.500,00" FontSize="14" FontWeight="Bold" Foreground="#2563EB"/>
                    </Border>
                </DockPanel>
                <TextBlock Text="Este artículo cuenta con variantes de color o modelo con control de stock individual. Seleccione el color que lleva el cliente:"
                           FontSize="12" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Grilla de Variantes -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
            <DataGrid x:Name="DgVariantes"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F1F5F9"
                      RowHeight="42"
                      FontSize="13"
                      Background="White"
                      BorderThickness="0"
                      SelectionMode="Single"
                      MouseDoubleClick="DgVariantes_MouseDoubleClick">
                <DataGrid.Columns>
                    <!-- Color / Variante -->
                    <DataGridTextColumn Header="Color / Variante" Binding="{Binding Nombre}" Width="*" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="13.5"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="10,0,0,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Código de Barras -->
                    <DataGridTextColumn Header="Código de Barras" Binding="{Binding CodigoBarras}" Width="170" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Stock Actual Disponible -->
                    <DataGridTemplateColumn Header="Stock Disponible" Width="140" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#DCFCE7"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StockBajo}" Value="True">
                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Agotado}" Value="True">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StockActual, StringFormat='{}{0:N0} u.'}" FontWeight="Bold" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#166534"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StockBajo}" Value="True">
                                                        <Setter Property="Foreground" Value="#92400E"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Agotado}" Value="True">
                                                        <Setter Property="Foreground" Value="#991B1B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Botones de Acción -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="[↑/↓] Navegar • [ENTER] Seleccionar • [ESC] Cancelar" VerticalAlignment="Center" Foreground="#64748B" FontSize="12"/>

            <Button Grid.Column="1" Content="Cancelar [ESC]" Click="BtnCancelar_Click" Padding="16,8" FontSize="13" Margin="0,0,10,0" Cursor="Hand"/>
            <Button Grid.Column="2" Content="➕ Seleccionar Color [ENTER]" Click="BtnSeleccionar_Click" Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="18,8" FontSize="13" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
