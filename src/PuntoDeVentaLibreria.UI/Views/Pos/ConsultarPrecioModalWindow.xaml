<Window x:Class="PuntoDeVentaLibreria.UI.Views.Pos.ConsultarPrecioModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="🔍 Verificador / Consulta Rápida de Precios [F5]" 
        Height="630" Width="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Cabecera y buscador -->
            <RowDefinition Height="*"/>    <!-- Tarjeta de Resultado -->
            <RowDefinition Height="Auto"/> <!-- Botonera inferior -->
        </Grid.RowDefinitions>

        <!-- CABECERA Y BUSCADOR -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <DockPanel Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔍" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="CONSULTA RÁPIDA DE PRECIOS" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnAbrirListaAnterior" Content="📜 Lista Sistema Anterior [F8]" Click="BtnAbrirListaAnterior_Click"
                            Background="#FFFBEB" Foreground="#B45309" BorderBrush="#FDE68A" BorderThickness="1.5"
                            Padding="10,5" FontSize="11.5" FontWeight="Bold" Cursor="Hand" Margin="0,0,10,0"
                            ToolTip="Consultar la lista original exportada del sistema anterior por cualquier duda sobre este u otro código"/>
                    <TextBlock Text="MR SYS Librería" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>

            <!-- Barra de Búsqueda / Pistola Barcode -->
            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="10" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="📷 Escanee o escriba:" FontSize="13" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <TextBox x:Name="TxtBusqueda" Grid.Column="1" FontSize="16" FontWeight="SemiBold" Padding="8,4"
                             BorderBrush="#94A3B8" BorderThickness="1" KeyDown="TxtBusqueda_KeyDown"/>

                    <Button Grid.Column="2" Content="Buscar [ENTER]" Click="BtnBuscar_Click"
                            Margin="8,0,0,0" Padding="14,6" FontWeight="Bold" Background="#7C3AED" Foreground="White" Cursor="Hand"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- PANEL DE RESULTADOS -->
        <Grid Grid.Row="1">
            <!-- ESTADO INICIAL: ESPERANDO ESCANEO -->
            <Border x:Name="PanelInicial" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="24"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="🏷️" FontSize="52" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="Pistolee un código de barras o busque un artículo" FontSize="16" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center"/>
                    <TextBlock Text="Verá en pantalla gigante el precio con Tarjeta y con Descuento en Efectivo." 
                               FontSize="12.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    <TextBlock Text="Si el producto es un Pack o tiene versión individual (-1), podrá ver y elegir ambos precios." 
                               FontSize="11.5" Foreground="#7C3AED" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- ESTADO RESULTADO: ARTÍCULO ENCONTRADO -->
            <Border x:Name="PanelResultado" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="18"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Nombre y Datos -->
                        <RowDefinition Height="*"/>    <!-- Comparativa de Precios del artículo escaneado -->
                        <RowDefinition Height="Auto"/> <!-- Sección Vinculada Pack o Suelto (si existe) -->
                        <RowDefinition Height="Auto"/> <!-- Stock y Atributos -->
                    </Grid.RowDefinitions>

                    <!-- Detalle del Artículo Escaneado -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel VerticalAlignment="Center">
                            <DockPanel>
                                <TextBlock x:Name="TxtBadgeTipo" Text="📦 PACK" Background="#EEF2FF" Foreground="#4F46E5" 
                                           FontWeight="Bold" FontSize="11" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtNombreArticulo" Text="Nombre del Producto" FontSize="18" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap"/>
                            </DockPanel>
                            
                            <WrapPanel Margin="0,4,0,0">
                                <TextBlock x:Name="TxtSkuArticulo" Text="SKU: LP100" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,12,0"/>
                                <TextBlock x:Name="TxtCodigoArticulo" Text="Código: 77912345678" FontSize="12" Foreground="#64748B" Margin="0,0,12,0"/>
                                <TextBlock x:Name="TxtRubroArticulo" Text="Categoría: Librería" FontSize="12" Foreground="#0284C7" FontWeight="SemiBold" Margin="0,0,12,0"/>
                                <Button Content="📜 Ver en Lista Anterior" Click="BtnConsultarArticuloEnListaAnterior_Click"
                                        Background="Transparent" BorderThickness="0" Foreground="#B45309" FontWeight="SemiBold" FontSize="11.5" Cursor="Hand" Padding="0"/>
                            </WrapPanel>
                        </StackPanel>
                    </DockPanel>

                    <!-- TARJETAS DUALES DE PRECIO DEL ARTÍCULO PRINCIPAL -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- TARJETA 1: PRECIO TARJETA (LISTA) -->
                        <Border Grid.Column="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="10" Padding="14,10">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtEtiquetaTarjeta" Text="💳 TARJETA / LISTA" FontWeight="Bold" FontSize="12" Foreground="#475569" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtPrecioTarjeta" Text="$125.00" FontSize="30" FontWeight="Black" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,4"/>
                                <TextBlock Text="Débito, Crédito (1 pago) o Cta. Cte." FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- TARJETA 2: PRECIO EFECTIVO / TRANSFERENCIA -->
                        <Border Grid.Column="2" Background="#F0FDF4" BorderBrush="#22C55E" BorderThickness="2" CornerRadius="10" Padding="14,10">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="💵 EFECTIVO / TRANSF." FontWeight="Black" FontSize="12" Foreground="#15803D"/>
                                    <TextBlock x:Name="TxtPorcentajeDesc" Text=" (-10%)" FontWeight="Bold" FontSize="12" Foreground="#16A34A"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtPrecioEfectivo" Text="$112.50" FontSize="32" FontWeight="Black" Foreground="#15803D" HorizontalAlignment="Center" Margin="0,2"/>
                                <Border Background="#DCFCE7" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtAhorroEfectivo" Text="Ahorro: $12.50" FontWeight="Bold" FontSize="10.5" Foreground="#166534"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- SECCIÓN VINCULADA: PACK O UNIDAD INDIVIDUAL (-1) -->
                    <Border x:Name="PanelVinculoPackUnidad" Grid.Row="2" Background="#FAF5FF" BorderBrush="#D8B4FE" BorderThickness="1.5" CornerRadius="10" Padding="12,10" Margin="0,0,0,10"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock x:Name="TxtTituloVinculado" Text="🔗 VERSIÓN INDIVIDUAL SUELTA DISPONIBLE (-1):" 
                                           FontWeight="Bold" FontSize="12" Foreground="#6B21A8" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtSkuVinculado" Text="SKU: LP100-1" FontSize="11" Foreground="#7E22CE" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtNombreVinculado" Text="Lapicera Bic Azul (Unidad Suelta)" FontSize="13" FontWeight="SemiBold" Foreground="#1E1B4B" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="💳 Tarjeta: " FontSize="12" Foreground="#4B5563"/>
                                        <TextBlock x:Name="TxtPrecioTarjetaVinculado" Text="$350.00" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,12,0"/>
                                        <TextBlock Text="💵 Efectivo: " FontSize="12" Foreground="#15803D" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtPrecioEfectivoVinculado" Text="$315.00" FontSize="13" FontWeight="Black" Foreground="#16A34A"/>
                                    </StackPanel>
                                </StackPanel>

                                <Button x:Name="BtnLlevarVinculado" Grid.Column="2" Content="➕ Llevar Unidad Suelta [U]" Click="BtnLlevarVinculado_Click"
                                        Background="#7C3AED" Foreground="White" FontWeight="Bold" Padding="12,6" FontSize="11.5" Cursor="Hand"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- STOCK Y ESTADO -->
                    <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,6">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📦 Stock disponible: " FontSize="11.5" Foreground="#475569"/>
                                <TextBlock x:Name="TxtStock" Text="24 unidades" FontSize="11.5" FontWeight="Bold" Foreground="#0F172A"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtDetalleExtra" Text="" FontSize="11" Foreground="#059669" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ESTADO NO ENCONTRADO -->
            <Border x:Name="PanelNoEncontrado" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="12" Padding="18"
                    Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="⚠️" FontSize="38" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Artículo no encontrado en el sistema actual" FontSize="16" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtNoEncontradoDetalle" Text="No se encontraron artículos con ese código o término." 
                               FontSize="12" Foreground="#991B1B" HorizontalAlignment="Center" Margin="0,4,0,10"/>

                    <!-- TARJETA DE COINCIDENCIA EN SISTEMA ANTERIOR (AUDITORÍA) -->
                    <Border x:Name="PanelEncontradoHistorico" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1.5" CornerRadius="8" Padding="14,10"
                            Visibility="Collapsed" MaxWidth="600" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="🛡️ COINCIDENCIA EN LA LISTA ORIGINAL DEL SISTEMA ANTERIOR:" FontWeight="Bold" FontSize="12" Foreground="#92400E"/>
                            <TextBlock x:Name="TxtHistoricoDetalle" Text="Cód: 1234 | Libreta 50 Hojas | P. Venta: $1.200 | Provee: El Once" 
                                       FontSize="12" Foreground="#78350F" Margin="0,4,0,6" TextWrapping="Wrap"/>
                            <Button Content="📜 Abrir Ficha en Lista del Sistema Anterior [F8]" Click="BtnAbrirListaAnterior_Click"
                                    Background="#D97706" Foreground="White" FontWeight="Bold" Padding="12,5" FontSize="11.5" Cursor="Hand" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- BOTONERA INFERIOR -->
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Cerrar [ESC]" Click="BtnCerrar_Click" Padding="16,8" FontSize="12.5" Cursor="Hand"/>
                <Button Content="📜 Lista Anterior [F8]" Click="BtnAbrirListaAnterior_Click" 
                        Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"
                        Padding="12,8" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" Cursor="Hand"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnLlevarVinculadoInferior" Content="➕ Llevar Unidad Suelta [U]" Click="BtnLlevarVinculado_Click"
                        Background="#7C3AED" Foreground="White" FontWeight="Bold" Padding="16,8" FontSize="12.5" Cursor="Hand" Margin="0,0,10,0"
                        Visibility="Collapsed"/>
                <Button x:Name="BtnAgregarAlTicket" Content="➕ Agregar al Carrito [ENTER]" Click="BtnAgregarAlTicket_Click" 
                        IsEnabled="False"
                        Background="#16A34A" Foreground="White" FontWeight="Bold" Padding="20,9" FontSize="13" Cursor="Hand"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
