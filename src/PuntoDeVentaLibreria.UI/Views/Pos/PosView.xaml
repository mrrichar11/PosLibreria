<UserControl x:Class="PuntoDeVentaLibreria.UI.Views.Pos.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <!-- CUERPO PRINCIPAL DEL TPV (2 Columnas) -->
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="65*"/>
            <ColumnDefinition Width="35*"/>
        </Grid.ColumnDefinitions>

        <!-- COLUMNA IZQUIERDA: LECTOR, TICKET Y COBRO (65%) -->
        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0: Barra Escáner -->
                <RowDefinition Height="Auto"/> <!-- 1: Barra Ventas en Espera -->
                <RowDefinition Height="*"/>    <!-- 2: Grilla del Ticket -->
                <RowDefinition Height="Auto"/> <!-- 3: Barra de Estado -->
                <RowDefinition Height="Auto"/> <!-- 4: Tarjeta Total Gigante -->
                <RowDefinition Height="Auto"/> <!-- 5: Botonera de Acción -->
            </Grid.RowDefinitions>

            <!-- BARRA DE LECTURA ÓPTICA PERPETUA [F1] -->
            <Border Grid.Row="0" Background="White" CornerRadius="10" BorderBrush="#CBD5E1" BorderThickness="1.5" Padding="14,10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="📷" FontSize="20" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="[F1] ESCANEAR / BUSCAR:" FontSize="12" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBox x:Name="TxtCodigoBarras" Grid.Column="1"
                             Text="{Binding CodigoBarrasInput, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="16" FontWeight="SemiBold" Padding="8,4"
                             BorderThickness="1" BorderBrush="#94A3B8"
                             VerticalAlignment="Center"/>

                    <Button Grid.Column="2" Content="Buscar [Enter]" Command="{Binding EscanearCodigoCommand}"
                            Margin="8,0,0,0" Padding="14,6" FontWeight="Bold" Cursor="Hand"
                            Background="#2563EB" Foreground="White"/>

                    <Button Grid.Column="3" Content="🔍 Consultar [F5]" Command="{Binding ConsultarPrecioCommand}"
                            Margin="8,0,0,0" Padding="12,6" FontWeight="Bold" Cursor="Hand"
                            Background="#7C3AED" Foreground="White"
                            ToolTip="Consultar precio y descuento en pantalla gigante [F5]"/>

                    <Button Grid.Column="4" Content="➕ Alta Rápida [F3]" Command="{Binding AbrirAltaRapidaCommand}"
                            Margin="8,0,0,0" Padding="12,6" FontWeight="Bold" Cursor="Hand"
                            Background="#10B981" Foreground="White"
                            ToolTip="Dar de alta un artículo no registrado e insertarlo directamente al ticket [F3]"/>
                </Grid>
            </Border>

            <!-- BANDEJA DE TICKETS EN ESPERA (MULTI-TICKET) -->
            <Border Grid.Row="1" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1.5" CornerRadius="8" Padding="10,8" Margin="0,0,0,8"
                    Visibility="{Binding HayVentasEnEspera, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="⏸️" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="VENTAS EN ESPERA:" FontWeight="Black" FontSize="11" Foreground="#92400E" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding VentasEnEspera}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFFBEB" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,4">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Botón para Reanudar -->
                                        <Button Content="{Binding ResumenTexto}"
                                                Command="{Binding DataContext.ReanudarVentaEnEsperaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0" FontWeight="Bold" FontSize="11" Foreground="#B45309"
                                                Cursor="Hand" ToolTip="Haga clic para retomar este ticket"/>
                                        <!-- Botón para Descartar con confirmación -->
                                        <Button Content="✕" 
                                                Command="{Binding DataContext.DescartarVentaEnEsperaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0" Foreground="#DC2626" FontWeight="Black" FontSize="11"
                                                Margin="6,0,0,0" Padding="3,0" Cursor="Hand" ToolTip="Descartar este ticket en espera"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- GRILLA DEL TICKET EN CURSO -->
            <Border Grid.Row="2" Background="{DynamicResource FondoDataGridBrush}" CornerRadius="10" BorderBrush="{DynamicResource BordeTarjetaBrush}" BorderThickness="1" Margin="0,0,0,8">
                <DataGrid x:Name="GridCarrito"
                          ItemsSource="{Binding Items}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource HorizontalGridLinesBrush}"
                          RowHeight="44"
                          FontSize="13"
                          Background="{DynamicResource FondoDataGridBrush}"
                          RowBackground="{DynamicResource FondoDataGridBrush}"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <!-- Código / SKU -->
                        <DataGridTextColumn Header="Código / SKU" Binding="{Binding SKU}" Width="100" IsReadOnly="True"/>

                        <!-- Descripción -->
                        <DataGridTemplateColumn Header="Descripción del Artículo / Útil" Width="*" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="2,0">
                                        <TextBlock Text="{Binding Descripcion}" FontWeight="SemiBold" Foreground="{DynamicResource TextoNormalBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DetalleDolar}" FontSize="10" FontWeight="Bold" Foreground="#16A34A"
                                                   Visibility="{Binding EsPrecioDolar, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Cantidad con Controles +/- -->
                        <DataGridTemplateColumn Header="Cantidad" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Content="-" Width="24" Height="24" Padding="0" FontWeight="Bold" Margin="0,0,4,0"
                                                Command="{Binding DataContext.DecrementarCantidadCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                        <TextBlock Text="{Binding Cantidad, StringFormat='N0'}" FontWeight="Bold" FontSize="14" Width="30" TextAlignment="Center" VerticalAlignment="Center"/>
                                        <Button Content="+" Width="24" Height="24" Padding="0" FontWeight="Bold" Margin="4,0,0,0"
                                                Command="{Binding DataContext.IncrementarCantidadCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Precio Tarjeta (Lista) -->
                        <DataGridTemplateColumn Header="P. Tarjeta" Width="95" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding PrecioUnitario, StringFormat='${0:N2}'}" FontWeight="SemiBold" Foreground="{DynamicResource TextoNormalBrush}" TextAlignment="Right"/>
                                        <TextBlock Text="Lista" FontSize="9" Foreground="#64748B" TextAlignment="Right"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Precio Efectivo / Transferencia -->
                        <DataGridTemplateColumn Header="P. Efectivo" Width="105" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding PrecioEfectivo, StringFormat='${0:N2}'}" FontWeight="Bold" Foreground="#16A34A" TextAlignment="Right"/>
                                        <TextBlock Text="{Binding PorcentajeDescuentoEfectivoTexto}" FontSize="9" FontWeight="Bold" Foreground="#15803D" TextAlignment="Right"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Subtotal -->
                        <DataGridTemplateColumn Header="Subtotal" Width="110" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding Subtotal, StringFormat='${0:N2}'}" FontWeight="Bold" Foreground="{DynamicResource TextoTituloBrush}" TextAlignment="Right"/>
                                        <TextBlock Text="{Binding SubtotalEfectivo, StringFormat='Ef: ${0:N2}'}" FontSize="10" FontWeight="SemiBold" Foreground="#15803D" TextAlignment="Right"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Botón Quitar -->
                        <DataGridTemplateColumn Header="" Width="38">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="❌" Width="26" Height="26" Padding="0" Foreground="#EF4444"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding DataContext.EliminarItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- BARRA DE ESTADO / MENSAJES -->
            <Border Grid.Row="3" Background="#E2E8F0" CornerRadius="6" Padding="12,6" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding MensajeEstado}" Foreground="#334155" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding NumeroComprobanteUltimaVenta, StringFormat='Última Venta: {0}'}" 
                                   Foreground="#64748B" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="🖨 Reimprimir [F9]" Command="{Binding ReimprimirUltimoTicketCommand}"
                                Visibility="{Binding TieneUltimaVenta, Converter={StaticResource BoolToVis}}"
                                Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="11"
                                Padding="8,3" Cursor="Hand" BorderThickness="0"
                                ToolTip="Reimprimir o previsualizar ticket de la última venta realizada [F9]"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- TARJETA DE TOTALES GIGANTE: DUAL TARJETA Y EFECTIVO -->
            <Border Grid.Row="4" Background="#0F172A" CornerRadius="12" Padding="18,12" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding CantidadArticulos, StringFormat='Artículos en ticket: {0}'}" Foreground="#94A3B8" FontSize="12"/>
                        <TextBlock Text="{Binding SubtotalBruto, StringFormat='Subtotal: ${0:N2}'}" Foreground="#CBD5E1" FontSize="13" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- TOTAL TARJETA (LISTA) -->
                    <Border Grid.Column="1" Background="#1E293B" CornerRadius="8" Padding="14,6" Margin="10,0" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="💳 TOTAL TARJETA / LISTA" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalVenta, StringFormat='${0:N2}'}" Foreground="#F8FAFC" FontSize="22" FontWeight="Black" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- TOTAL EFECTIVO / TRANSFERENCIA (-10%) -->
                    <Border Grid.Column="2" Background="#14532D" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="8" Padding="16,6" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Right">
                            <DockPanel>
                                <TextBlock Text="💵 EFECTIVO / TRANSF." Foreground="#86EFAC" FontSize="11" FontWeight="Black"/>
                                <TextBlock Text="{Binding PorcentajeDescuentoEfectivo, StringFormat=' (-{0:0.#}%)'}" Foreground="#BBF7D0" FontSize="11" FontWeight="Bold"/>
                            </DockPanel>
                            <TextBlock Text="{Binding TotalEfectivo, StringFormat='${0:N2}'}" Foreground="White" FontSize="28" FontWeight="Black" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding TotalAhorroEfectivo, StringFormat='Ahorro: ${0:N2}'}" Foreground="#86EFAC" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- BOTONES DE ACCIÓN Y COBRO DEL PUNTO DE VENTA -->
            <Grid Grid.Row="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- BOTÓN PRINCIPAL DE COBRO: 100% VISIBLE Y PROMINENTE -->
                <Button Grid.Row="0" Command="{Binding AbrirCobroCommand}"
                        Style="{StaticResource BotonCobrarPosStyle}"
                        ToolTip="Finalizar venta y abrir ventana de cobro [F2] o [Espacio]">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="💰 COBRAR TICKET" FontSize="15" FontWeight="Black" Margin="0,0,8,0"/>
                        <TextBlock Text="[F2] / [ESPACIO]" FontSize="13" FontWeight="Bold" Opacity="0.9" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- BOTONES SECUNDARIOS EN GRILLA UNIFORME EQUILIBRADA (5 BOTONES) -->
                <UniformGrid Grid.Row="1" Rows="1" Columns="5">
                    <!-- [F5] CONSULTAR PRECIO -->
                    <Button Content="🔍 Consultar [F5]" Command="{Binding ConsultarPrecioCommand}"
                            Style="{StaticResource BotonConsultarStyle}" Margin="0,0,3,0"
                            ToolTip="Verificador de precios en pantalla gigante con descuento en efectivo [F5]"/>

                    <!-- [F3] ALTA RÁPIDA -->
                    <Button Content="➕ Alta Rápida [F3]" Command="{Binding AbrirAltaRapidaCommand}"
                            Style="{StaticResource BotonAltaRapidaStyle}" Margin="3,0,3,0"
                            ToolTip="Registrar artículo no existente e insertarlo al ticket [F3]"/>

                    <!-- [F6] VENTA MANUAL -->
                    <Button Content="📝 Manual [F6]" Command="{Binding AgregarVentaManualCommand}"
                            Style="{StaticResource BotonManualStyle}" Margin="3,0,3,0"
                            ToolTip="Agregar concepto o servicio manual libre [F6]"/>

                    <!-- [F4] EN ESPERA / MULTI-TICKET -->
                    <Button Content="⏸️ En Espera [F4]" Command="{Binding PausarVentaActualCommand}"
                            Style="{StaticResource BotonEnEsperaStyle}" Margin="3,0,3,0"
                            ToolTip="Poner venta en espera para atender a otro cliente [F4]"/>

                    <!-- [F12] VACIAR TICKET -->
                    <Button Content="🗑 Vaciar [F12]" Command="{Binding LimpiarTicketConConfirmacionCommand}"
                            Style="{StaticResource BotonVaciarStyle}" Margin="3,0,0,0"
                            ToolTip="Cancelar y vaciar todos los artículos del ticket actual [F12]"/>
                </UniformGrid>
            </Grid>
        </Grid>

        <!-- COLUMNA DERECHA: BOTONERA RÁPIDA TÁCTIL Y COMBOS (35%) -->
        <Border Grid.Column="1" Background="{DynamicResource FondoTarjetaBrush}" CornerRadius="12" BorderBrush="{DynamicResource BordeTarjetaBrush}" BorderThickness="1" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cabecera Botonera -->
                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock Text="BOTONERA RÁPIDA &amp; KITS" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextoTituloBrush}"/>
                </DockPanel>
                <TextBlock Grid.Row="1" Text="Fotocopias, impresiones y combos escolares sin código de barras" 
                           FontSize="11" Foreground="{DynamicResource TextoSubtituloBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <!-- Lista de Botones Rápidos -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding BotonesRapidos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource FondoControlSecundarioBrush}" BorderBrush="{DynamicResource BordeTarjetaBrush}" BorderThickness="1" CornerRadius="10" 
                                        Padding="12,10" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Nombre}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextoTituloBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding CategoriaNombre}" FontSize="11" Foreground="{DynamicResource TextoSubtituloBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <Button Grid.Column="1" Command="{Binding DataContext.AgregarBotonRapidoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Background="#0284C7" Foreground="White" FontWeight="Bold"
                                                Padding="12,6" Margin="8,0,0,0" Cursor="Hand" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PrecioVenta, StringFormat='${0:N2}'}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Atajo de Teclado Info -->
                <Border Grid.Row="3" Background="{DynamicResource FondoControlSecundarioBrush}" CornerRadius="8" Padding="10,6" Margin="0,8,0,0">
                    <TextBlock Text="💡 Tip: Haga clic en cualquier útil o servicio para agregarlo al ticket." FontSize="11" Foreground="{DynamicResource TextoSubtituloBrush}" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
