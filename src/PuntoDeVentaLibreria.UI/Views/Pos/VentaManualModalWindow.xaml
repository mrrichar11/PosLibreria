<Window x:Class="PuntoDeVentaLibreria.UI.Views.Pos.VentaManualModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Venta Rápida / Concepto Manual" 
        Height="400" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="VENTA RÁPIDA / MANUAL" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="Cargue un concepto y precio libre para mostrador" FontSize="12" Foreground="#64748B"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Descripción del Concepto / Artículo:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtDescripcion" Text="Venta Mostrador / Servicios Varios" FontSize="14" Padding="8,6" Margin="0,0,0,14"/>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Precio Unitario ($):" FontSize="12" FontWeight="Bold" Foreground="#0284C7" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtPrecio" Text="150" FontSize="20" FontWeight="Bold" Padding="8,6"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Cantidad:" FontSize="12" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtCantidad" Text="1" FontSize="20" FontWeight="Bold" Padding="8,6"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <Button Content="Cancelar [ESC]" Click="BtnCancelar_Click" Padding="16,8" FontSize="13" Cursor="Hand"/>
            <Button Content="➕ Agregar al Ticket [ENTER]" Click="BtnConfirmar_Click" HorizontalAlignment="Right"
                    Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="20,8" FontSize="13" Cursor="Hand"/>
        </DockPanel>
    </Grid>
</Window>
