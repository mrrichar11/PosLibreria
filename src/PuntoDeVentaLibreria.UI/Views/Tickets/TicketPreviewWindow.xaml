<Window x:Class="PuntoDeVentaLibreria.UI.Views.Tickets.TicketPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Vista Previa de Ticket - MR SYS"
        Width="500" Height="720"
        MinWidth="420" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#F1F5F9"
        WindowStyle="SingleBorderWindow">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra Superior: Título e Info -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="🧾 VISTA PREVIA DEL COMPROBANTE" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                    <TextBlock x:Name="TxtInfoImpresora" Text="Impresora: Predeterminada de Windows" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#EEF2FF" CornerRadius="6" Padding="8,4">
                    <TextBlock x:Name="TxtAnchoBadge" Text="80 mm" FontWeight="Bold" FontSize="11" Foreground="#4F46E5"/>
                </Border>
            </Grid>
        </Border>

        <!-- Contenedor de Papel Térmico con Sombra -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border x:Name="BorderPapelTicket" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="20,24" HorizontalAlignment="Center" Margin="10,0,10,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" Direction="270" Opacity="0.12" ShadowDepth="4" Color="#000000"/>
                </Border.Effect>

                <TextBlock x:Name="TxtContenidoTicket"
                           FontFamily="Consolas, Courier New, monospace"
                           FontSize="12.5"
                           LineHeight="18"
                           Foreground="#0F172A"
                           TextWrapping="NoWrap"
                           Text="Generando ticket..."/>
            </Border>
        </ScrollViewer>

        <!-- Barra Inferior de Botones de Acción -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="💾 Guardar Copia TXT" Click="BtnGuardarCopia_Click"
                        Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Padding="12,8" FontWeight="SemiBold" Cursor="Hand" FontSize="12"/>

                <Button Grid.Column="2" Content="✖ Cerrar [Esc]" IsCancel="True" Click="BtnCerrar_Click"
                        Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14,8" FontWeight="SemiBold" Cursor="Hand" FontSize="12" Margin="0,0,8,0"/>

                <Button Grid.Column="3" Content="🖨 Imprimir Ticket [Enter]" IsDefault="True" Click="BtnImprimir_Click"
                        Background="#16A34A" Foreground="White" BorderThickness="0" Padding="18,8" FontWeight="Bold" Cursor="Hand" FontSize="13"/>
            </Grid>
        </Border>
    </Grid>
</Window>
