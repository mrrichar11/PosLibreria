<Window x:Class="PuntoDeVentaLibreria.UI.Views.Clientes.HistorialClienteModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Historial de Movimientos de Cuenta" 
        Height="550" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="TxtTitulo" Text="HISTORIAL DE MOVIMIENTOS" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock x:Name="TxtSubtitulo" Text="Cliente: -" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
            </StackPanel>

            <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="LÍMITE CRÉDITO" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock x:Name="TxtLimite" Text="$0.00" FontSize="14" FontWeight="Bold" Foreground="#334155"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="12,6">
                <StackPanel>
                    <TextBlock Text="SALDO DEUDOR PENDIENTE" FontSize="10" FontWeight="Bold" Foreground="#991B1B"/>
                    <TextBlock x:Name="TxtSaldoDeudor" Text="$0.00" FontSize="16" FontWeight="Black" Foreground="#DC2626"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Grilla de Movimientos -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
            <DataGrid x:Name="GridMovimientos"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F1F5F9"
                      RowHeight="38"
                      FontSize="12"
                      Background="White"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Fecha / Hora" Binding="{Binding Fecha, StringFormat='dd/MM/yyyy HH:mm'}" Width="130"/>
                    <DataGridTextColumn Header="Tipo Operación" Binding="{Binding Tipo}" Width="160" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Comprobante" Binding="{Binding Comprobante}" Width="140"/>
                    <DataGridTextColumn Header="Medio Pago" Binding="{Binding MetodoPago}" Width="110"/>
                    <DataGridTextColumn Header="Monto" Binding="{Binding Monto, StringFormat='${0:N2}'}" Width="110" FontWeight="Bold"/>
                    <DataGridTextColumn Header="Detalle" Binding="{Binding Detalle}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Pie -->
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="TxtCantidadMovimientos" Text="0 movimientos registrados" VerticalAlignment="Center" FontSize="12" Foreground="#64748B"/>
            <Button Content="Cerrar" HorizontalAlignment="Right" Click="BtnCerrar_Click" Padding="20,8" FontSize="13" Cursor="Hand"/>
        </DockPanel>
    </Grid>
</Window>
