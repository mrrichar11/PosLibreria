<UserControl x:Class="PuntoDeVentaLibreria.UI.Views.Configuracion.ConfiguracionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:PuntoDeVentaLibreria.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="CONFIGURACIÓN DEL SISTEMA" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Ajustes de comercio, finanzas, tickets, backups, licencia y actualizaciones" FontSize="12" Foreground="#64748B"/>
            </StackPanel>

            <Button Grid.Column="1" Content="💾 Guardar Cambios" Command="{Binding GuardarConfiguracionCommand}"
                    Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="20,10" FontSize="14" Cursor="Hand"/>
        </Grid>

        <!-- Pestañas de Configuración -->
        <TabControl Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
            <!-- TAB 1: DATOS DEL COMERCIO -->
            <TabItem Header="🏬 Datos del Comercio">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel MaxWidth="700" HorizontalAlignment="Left">
                        <TextBlock Text="INFORMACIÓN GENERAL DEL NEGOCIO" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>

                        <TextBlock Text="Nombre Comercial de la Librería:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Config.NombreComercio, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8,6" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="CUIT / Identificación Tributaria:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Config.Cuit, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8,6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Teléfono / WhatsApp:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Config.Telefono, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8,6"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Dirección / Domicilio del Local:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Config.Direccion, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8,6" Margin="0,0,0,12"/>

                        <TextBlock Text="Vendedora / Cajero por Defecto:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Config.VendedoraDefecto, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8,6" Margin="0,0,0,14"/>

                        <!-- LOGO DEL COMERCIO -->
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="🖼️ LOGO / IDENTIDAD VISUAL DEL COMERCIO" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
                                <TextBlock Text="El logo aparecerá en la pantalla de inicio de sesión (Login) y en la barra lateral del programa." 
                                           FontSize="11" Foreground="#64748B" Margin="0,0,0,12"/>

                                <DockPanel LastChildFill="True">
                                    <!-- Vista previa del logo -->
                                    <Border DockPanel.Dock="Left" Width="90" Height="90" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Margin="0,0,16,0">
                                        <Grid>
                                            <TextBlock Text="Sin Logo" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding Config.LogoRuta}" Stretch="Uniform" Margin="4"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Config.LogoRuta, FallbackValue='Ningún archivo seleccionado'}" FontSize="11" Foreground="#475569" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="📁 Cargar / Cambiar Logo..." Command="{Binding CargarLogoCommand}"
                                                    Background="#2563EB" Foreground="White" FontWeight="SemiBold" Padding="12,6" FontSize="12" Margin="0,0,8,0" Cursor="Hand"/>
                                            <Button Content="❌ Quitar" Command="{Binding QuitarLogoCommand}"
                                                    Background="#F1F5F9" Foreground="#DC2626" BorderBrush="#CBD5E1" Padding="10,6" FontSize="12" Cursor="Hand"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- PAÍS, MONEDA Y BILLETES EN CIRCULACIÓN -->
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="🌍 PAÍS, MONEDA Y BILLETES EN CIRCULACIÓN" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
                                <TextBlock Text="Configura el país y los billetes rápidos que aparecerán en la ventana de cobro en efectivo." 
                                           FontSize="11" Foreground="#64748B" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Selector de País -->
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="País o Región:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="CmbPais" ItemsSource="{Binding PaisesDisponibles}" 
                                                  SelectedItem="{Binding Config.Pais, Mode=TwoWay}"
                                                  SelectionChanged="CmbPais_SelectionChanged"
                                                  FontSize="14" Padding="8,6"/>
                                    </StackPanel>

                                    <!-- Símbolo de Moneda -->
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Símbolo Moneda:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding Config.SimboloMoneda, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8,6"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Billetes Habilitados CSV -->
                                <TextBlock Text="Billetes en Circulación (separados por coma):" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Config.BilletesHabilitados, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8,6" Margin="0,0,0,6"/>
                                <TextBlock Text="💡 Ej: 100,200,500,1000,2000,10000,20000 (sin billete de 5000 para Argentina)" FontSize="11" Foreground="#475569"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: FINANZAS & MEDIOS DE PAGO -->
            <TabItem Header="💳 Finanzas &amp; Pagos">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel MaxWidth="700" HorizontalAlignment="Left">
                        <TextBlock Text="POLÍTICAS DE PRECIOS Y MEDIOS DE PAGO" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>

                        <!-- COTIZADOR DE DÓLAR (JOYERÍA / REGALERÍA / IMPORTADOS) -->
                        <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1.5" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <TextBlock Text="💵 COTIZADOR DE DÓLAR (JOYERÍA Y REGALERÍA)" FontSize="13" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border DockPanel.Dock="Right" Background="#DCFCE7" CornerRadius="6" Padding="8,3">
                                        <TextBlock Text="{Binding FechaCotizacionDolarTexto}" FontSize="11" FontWeight="SemiBold" Foreground="#166534"/>
                                    </Border>
                                </DockPanel>
                                <TextBlock Text="Actualice la cotización oficial o de reposición diaria del Dólar. Todos los artículos marcados con costo en dólares actualizarán automáticamente su costo y precio de venta en pesos al venderse o consultarse." 
                                           FontSize="11.5" Foreground="#166534" TextWrapping="Wrap" Margin="0,4,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Cotización 1 USD = ARS ($):" FontSize="12" FontWeight="SemiBold" Foreground="#14532D" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding CotizacionDolarInput, UpdateSourceTrigger=PropertyChanged}" FontSize="15" FontWeight="Black" Padding="10,6"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="💾 Actualizar Cotización Dólar" Command="{Binding ActualizarCotizacionDolarCommand}"
                                            Background="#16A34A" Foreground="White" FontWeight="Bold" FontSize="12" Padding="16,0" VerticalAlignment="Bottom" Height="38" Cursor="Hand"/>
                                </Grid>
                                <TextBlock Text="{Binding MensajeCotizacionDolar}" Foreground="#15803D" FontWeight="Bold" FontSize="11" Margin="0,6,0,0"
                                           Visibility="{Binding TieneMensajeCotizacion, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Descuento en Efectivo (%):" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Config.PorcentajeDescuentoEfectivo, UpdateSourceTrigger=PropertyChanged, StringFormat='N1'}" FontSize="14" Padding="8,6"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Margen Ganancia Sugerido (%):" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Config.MargenGananciaSugerido, UpdateSourceTrigger=PropertyChanged, StringFormat='N1'}" FontSize="14" Padding="8,6"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Cuotas y Tarjetas:" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,8,0,8"/>

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <CheckBox Content="Habilitar Plan 3 Cuotas" IsChecked="{Binding Config.Habilitar3Cuotas}" FontWeight="Bold" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Recargo 3 Cuotas (%):" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Width="100" Text="{Binding Config.Recargo3Cuotas, UpdateSourceTrigger=PropertyChanged, StringFormat='N1'}" Padding="6,4"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <CheckBox Content="Habilitar Plan 6 Cuotas" IsChecked="{Binding Config.Habilitar6Cuotas}" FontWeight="Bold" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Recargo 6 Cuotas (%):" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Width="100" Text="{Binding Config.Recargo6Cuotas, UpdateSourceTrigger=PropertyChanged, StringFormat='N1'}" Padding="6,4"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Tope Mensual de Retiros de Dueño ($):" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding Config.TopeMensualRetiroDueño, UpdateSourceTrigger=PropertyChanged, StringFormat='N2'}" FontSize="14" Padding="8,6"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: TICKETS & IMPRESIÓN -->
            <TabItem Header="🖨 Tickets &amp; Impresión">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="CONFIGURACIÓN DE TICKETS TÉRMICOS" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>

                        <!-- Impresora -->
                        <TextBlock Text="Impresora Térmica Instalada en Windows:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding ImpresorasDisponibles}" SelectedItem="{Binding Config.ImpresoraTickets}"
                                  FontSize="13" Padding="8,6" Margin="0,0,0,4"/>
                        <TextBlock Text="Deje en blanco o elija su impresora térmica. Si se deja en blanco, Windows preguntará la impresora al imprimir." FontSize="11" Foreground="#64748B" Margin="0,0,0,16"/>

                        <!-- Ancho de Papel -->
                        <TextBlock Text="Ancho de Papel Térmico:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <RadioButton Content="80 mm (Estándar Mostrador - 44 columnas)" IsChecked="{Binding EsPapel80Mm}" Margin="0,0,24,0" FontWeight="SemiBold"/>
                            <RadioButton Content="58 mm (Compacto de Mano - 32 columnas)" IsChecked="{Binding EsPapel58Mm}" FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- Opciones de Flujo de Venta -->
                        <TextBlock Text="Comportamiento en Punto de Venta:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <CheckBox Content="Mostrar siempre la vista previa en pantalla al finalizar el cobro"
                                          IsChecked="{Binding Config.MostrarVistaPreviaTicket}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <CheckBox Content="Mandar a imprimir automáticamente al confirmar la venta"
                                          IsChecked="{Binding Config.ImprimirAutomaticoAlCobrar}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- Mensaje de Pie de Ticket -->
                        <TextBlock Text="Mensaje de Pie / Políticas de Cambio del Ticket:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Config.MensajePieTicket, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="75"
                                 FontSize="13" Padding="8,6" Margin="0,0,0,4"/>
                        <TextBlock Text="Aparecerá centrado al final de cada comprobante. Puede usar varias líneas (Enter)." FontSize="11" Foreground="#64748B" Margin="0,0,0,20"/>

                        <!-- Botonera de Pruebas y Guardado -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="👁 Ver Vista Previa de Prueba" Command="{Binding ProbarVistaPreviaTicketCommand}"
                                    Background="#2563EB" Foreground="White" Padding="16,8" FontWeight="Bold" Cursor="Hand" Margin="0,0,10,0"/>

                            <Button Content="📄 Imprimir Ticket de Prueba" Command="{Binding ProbarTicketCommand}"
                                    Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Padding="14,8" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,10,0"/>

                            <Button Content="💾 Guardar Cambios de Ticket" Command="{Binding GuardarConfiguracionCommand}"
                                    Background="#16A34A" Foreground="White" Padding="16,8" FontWeight="Bold" Cursor="Hand"/>
                        </StackPanel>

                        <TextBlock Text="💡 Nota: Todas las ventas generan automáticamente una copia de auditoría en la carpeta ./Tickets/" FontSize="12" Foreground="#64748B"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: APARIENCIA & TEMA -->
            <TabItem Header="🎨 Apariencia &amp; Tema">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel MaxWidth="700" HorizontalAlignment="Left">
                        <TextBlock Text="SELECCIÓN DEL TEMA VISUAL FLUENT" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>
                        <TextBlock Text="Elija el contraste que prefiera para trabajar en mostrador:" FontSize="12" Foreground="#64748B" Margin="0,0,0,16"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <!-- Modo Claro -->
                            <Button Command="{Binding CambiarTemaCommand}" CommandParameter="Light"
                                    Width="180" Height="100" Margin="0,0,16,0" Padding="10" Cursor="Hand" Background="White" BorderBrush="#CBD5E1" BorderThickness="2">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="☀️" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="Modo Claro" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Foreground="#0F172A"/>
                                    <TextBlock Text="Fondo luminoso" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Modo Oscuro -->
                            <Button Command="{Binding CambiarTemaCommand}" CommandParameter="Dark"
                                    Width="180" Height="100" Padding="10" Cursor="Hand" Background="#0F172A" BorderBrush="#334155" BorderThickness="2">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="🌙" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="Modo Oscuro" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Foreground="White"/>
                                    <TextBlock Text="Alto contraste" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 5: PLAN & LICENCIA -->
            <TabItem Header="🔑 Plan &amp; Licencia">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel MaxWidth="700" HorizontalAlignment="Left">
                        <TextBlock Text="ESTADO DE LA SUSCRIPCIÓN" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>

                        <!-- Estado Actual Card -->
                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding EstadoLicencia.PlanNombre}" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                    <Border Grid.Column="1" Background="#2563EB" CornerRadius="6" Padding="8,4">
                                        <TextBlock Text="{Binding EstadoLicencia.DiasRestantes, StringFormat='{}{0} DÍAS RESTANTES'}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding EstadoLicencia.Mensaje}" FontSize="12" Foreground="#475569" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding EstadoLicencia.CodigoInstalacion, StringFormat='ID de Máquina: {0}'}" FontFamily="Consolas" FontWeight="SemiBold" FontSize="12" Foreground="#334155" VerticalAlignment="Center"/>
                                    <Button Content="📋 Copiar ID" Command="{Binding CopiarCodigoInstalacionCommand}"
                                            Background="#F1F5F9" Foreground="#0F172A" BorderBrush="#CBD5E1" FontWeight="SemiBold" FontSize="11" Padding="8,2" Margin="10,0,0,0" Cursor="Hand" ToolTip="Copiar código al portapapeles"/>
                                </StackPanel>

                                <!-- Contacto WhatsApp -->
                                <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right" Content="📲 Contactar por WhatsApp" Command="{Binding AbrirWhatsAppSoporteCommand}"
                                                Background="#16A34A" Foreground="White" FontWeight="Bold" Padding="12,6" FontSize="12" Cursor="Hand" Margin="10,0,0,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="💬 Soporte y Activación de Planes:" FontWeight="Bold" Foreground="#065F46" FontSize="11.5"/>
                                            <TextBlock Text="Solicite su clave para renovar o pasar al Plan PRO al +54 9 3493 495801" Foreground="#047857" FontSize="11"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Input Clave de Activación -->
                        <TextBlock Text="Activar o Renovar Clave de Suscripción:" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding ClaveActivacionInput, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="14" FontFamily="Consolas" Padding="8,6" Margin="0,0,10,0"/>
                            <Button Grid.Column="1" Content="✔ Activar Clave" Command="{Binding ActivarLicenciaCommand}"
                                     Background="#16A34A" Foreground="White" FontWeight="Bold" Padding="16,8" Cursor="Hand"/>
                        </Grid>

                        <TextBlock Text="{Binding MensajeActivacion}" FontWeight="Bold" Foreground="#2563EB" FontSize="12"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 6: ACTUALIZACIONES -->
            <!-- TAB 6: ACTUALIZACIONES -->
            <TabItem Header="🚀 Actualizaciones">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="ACTUALIZACIONES OFICIALES DEL SISTEMA" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
                        <TextBlock Text="Compruebe e instale las últimas versiones y mejoras de MR SYS en 1 clic de forma segura." FontSize="12" Foreground="#64748B" Margin="0,0,0,16"/>

                        <!-- ESTADO ACTUAL Y BUSQUEDA -->
                        <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <DockPanel LastChildFill="True" Margin="0,0,0,12">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="Versión Actualmente Instalada:" FontSize="12" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding ActualizacionInfo.VersionActual, StringFormat='v{0}'}" FontSize="18" FontWeight="Black" Foreground="#0F172A"/>
                                    </StackPanel>
                                    
                                    <Button DockPanel.Dock="Right" Content="🔄 Buscar Nueva Versión Ahora" Command="{Binding BuscarActualizacionesCommand}"
                                            Padding="16,8" FontWeight="Bold" Background="#2563EB" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"/>
                                </DockPanel>

                                <TextBlock Text="{Binding MensajeActualizacion}" FontSize="13" Foreground="#334155" FontWeight="SemiBold" Margin="0,0,0,8"/>

                                <!-- PANEL CUANDO HAY ACTUALIZACION DISPONIBLE -->
                                <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,8,0,0"
                                        Visibility="{Binding ActualizacionInfo.HayActualizacion, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <DockPanel LastChildFill="True" Margin="0,0,0,10">
                                            <StackPanel DockPanel.Dock="Left">
                                                <TextBlock Text="🎉 ¡NUEVA VERSIÓN OFICIAL DISPONIBLE!" FontSize="13" FontWeight="Bold" Foreground="#166534"/>
                                                <TextBlock Text="{Binding ActualizacionInfo.VersionDisponible, StringFormat='Nueva Versión: v{0}'}" FontSize="15" FontWeight="Black" Foreground="#15803D"/>
                                            </StackPanel>

                                            <Button DockPanel.Dock="Right" Content="🚀 Ver Novedades e Instalar en 1 Clic" Command="{Binding AbrirVentanaActualizacionCommand}"
                                                    Background="#16A34A" Foreground="White" FontWeight="Bold" Padding="16,8" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"/>
                                        </DockPanel>

                                        <!-- Notas del lanzamiento -->
                                        <TextBlock Text="Novedades incluidas:" FontSize="11" FontWeight="Bold" Foreground="#14532D" Margin="0,0,0,4"/>
                                        <Border Background="White" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="8" MaxHeight="100">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <TextBlock Text="{Binding ActualizacionInfo.NotasLanzamiento}" FontSize="11" Foreground="#374151" TextWrapping="Wrap"/>
                                            </ScrollViewer>
                                        </Border>

                                        <!-- Progreso de descarga si se hace inline -->
                                        <ProgressBar Value="{Binding ProgresoDescarga}" Height="8" Margin="0,10,0,0"
                                                     Visibility="{Binding EstaDescargandoActualizacion, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- GARANTIA DE BASE DE DATOS -->
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="🛡️" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Protección Total de Datos: Antes de cualquier actualización, el sistema genera automáticamente una copia de seguridad de la base de datos (punto_venta_libreria.db) y descarta cualquier base incluida en el paquete para proteger completamente sus ventas, stock y clientes." 
                                           FontSize="11" Foreground="#1E40AF" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 7: COPIAS DE SEGURIDAD (BACKUPS) -->
            <TabItem Header="🛡 Copias de Seguridad">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel HorizontalAlignment="Stretch">
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SISTEMA INTEGRAL DE COPIAS DE SEGURIDAD (BACKUPS)" FontSize="15" FontWeight="Bold" Foreground="#1E293B"/>
                                <TextBlock Text="Copias atómicas comprimidas en ZIP que protegen su inventario, ventas, clientes y caja." FontSize="12" Foreground="#64748B"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="📂 Abrir Carpeta" Command="{Binding AbrirCarpetaBackupsCommand}"
                                        Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" FontWeight="SemiBold" Padding="14,8" Margin="0,0,8,0" Cursor="Hand"/>
                                <Button Content="💾 Crear Copia Ahora" Command="{Binding CrearBackupAhoraCommand}"
                                        Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="16,8" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding MensajeBackup}" FontWeight="Bold" Foreground="#16A34A" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"/>

                        <!-- CONFIGURACIÓN DE RESPALDOS -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="⚙️ POLÍTICAS DE RESPALDO AUTOMÁTICO" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>
                                
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Carpeta de Destino de las Copias:" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Config.CarpetaBackupsPersonalizada, FallbackValue='(Predeterminada: ./Backups/ dentro del sistema)'}" FontSize="11" Foreground="#64748B"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="📁 Cambiar Carpeta..." Command="{Binding SeleccionarCarpetaBackupsCommand}"
                                            Background="#E2E8F0" Foreground="#0F172A" FontWeight="SemiBold" Padding="12,6" FontSize="12" Cursor="Hand"/>
                                </Grid>

                                <Separator Margin="0,6,0,12" Background="#E2E8F0"/>

                                <WrapPanel Margin="0,0,0,8">
                                    <CheckBox Content="Generar copia automática al realizar Cierre de Caja" IsChecked="{Binding Config.BackupAutomaticoAlCierreCaja}"
                                              FontWeight="SemiBold" Margin="0,0,24,6"/>
                                    <CheckBox Content="Generar copia automática al salir / cerrar el sistema" IsChecked="{Binding Config.BackupAutomaticoAlCerrarSistema}"
                                              FontWeight="SemiBold" Margin="0,0,24,6"/>
                                </WrapPanel>

                                <DockPanel LastChildFill="False" Margin="0,4,0,0">
                                    <TextBlock Text="Conservar copias de los últimos:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding Config.DiasRetencionBackups, UpdateSourceTrigger=PropertyChanged}" Width="50" FontSize="12" Padding="4,2" TextAlignment="Center"/>
                                    <TextBlock Text="días (los respaldos anteriores se purgan automáticamente para ahorrar espacio)." VerticalAlignment="Center" FontSize="12" Foreground="#64748B" Margin="8,0,0,0"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Historial de Backups -->
                        <TextBlock Text="Historial de Copias de Seguridad Guardadas:" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>
                        <DataGrid ItemsSource="{Binding HistorialBackups}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  Height="220"
                                  RowHeight="36"
                                  FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Archivo de Copia" Binding="{Binding NombreArchivo}" Width="*"/>
                                <DataGridTextColumn Header="Tipo" Binding="{Binding TipoBackup}" Width="160"/>
                                <DataGridTextColumn Header="Fecha / Hora" Binding="{Binding FechaFormateada}" Width="150"/>
                                <DataGridTextColumn Header="Tamaño" Binding="{Binding TamañoFormateado}" Width="90"/>
                                <DataGridTemplateColumn Header="Acciones" Width="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="📥 Restaurar" Command="{Binding DataContext.RestaurarBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Background="#0284C7" Foreground="White" FontWeight="SemiBold" Padding="8,4" FontSize="11" Margin="0,0,6,0" Cursor="Hand"/>
                                                <Button Content="🗑️" Command="{Binding DataContext.EliminarBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Background="#FEE2E2" Foreground="#DC2626" Padding="6,4" FontSize="11" Cursor="Hand" ToolTip="Eliminar archivo"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 8: CONEXIÓN Y NUBE (PLAN PRO MULTI-PC) -->
            <TabItem Header="🌐 Red y Nube (Plan PRO)">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                        <TextBlock Text="CONFIGURACIÓN DE RED Y BASE DE DATOS (PLAN PRO MULTI-TERMINAL)" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
                        <TextBlock Text="Permite conectar 2 o más computadoras (en el local o de forma remota desde su casa) trabajando sobre la misma información en tiempo real." 
                                   FontSize="12" Foreground="#64748B" Margin="0,0,0,16" TextWrapping="Wrap"/>

                        <!-- BANNER SI ESTÁ EN PLAN ESTÁNDAR -->
                        <Border Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1.5" CornerRadius="10" Padding="14" Margin="0,0,0,16"
                                Visibility="{Binding EstadoLicencia.EsPlanPro, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="⭐" FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Función Multi-Terminal habilitada en Plan PRO" FontSize="13" FontWeight="Bold" Foreground="#92400E"/>
                                    <TextBlock Text="Actualmente su sistema se encuentra en Plan Estándar (1 PC Local Offline). Para sincronizar 2 o más computadoras con base de datos en la nube (PostgreSQL / Supabase), solicite su Clave Plan PRO." 
                                               FontSize="11" Foreground="#B45309" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                    <Button Content="📲 Solicitar Activación Plan PRO por WhatsApp (+54 9 3493 495801)"
                                            Command="{Binding AbrirWhatsAppSoporteCommand}"
                                            Background="#25D366" Foreground="White" FontWeight="Bold" FontSize="11" Padding="12,6" HorizontalAlignment="Left" Cursor="Hand"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- MODO DE BASE DE DATOS -->
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="🔌 MOTOR DE BASE DE DATOS" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>
                                
                                <RadioButton Content="🔘 Base de Datos Local (SQLite - Plan Básico 1 PC Offline)" IsChecked="{Binding EsModoSqlite}" 
                                             FontWeight="Bold" FontSize="13" Foreground="#0F172A" Margin="0,0,0,6"/>
                                <TextBlock Text="Utiliza el archivo local embebido punto_venta_libreria.db. No requiere conexión a internet ni servidor externo." 
                                           FontSize="11" Foreground="#64748B" Margin="22,0,0,14"/>

                                <RadioButton Content="☁️ Base de Datos en Nube / Red (PostgreSQL - Plan PRO Multi-PC)" IsChecked="{Binding EsModoPostgres}" 
                                             FontWeight="Bold" FontSize="13" Foreground="#2563EB" Margin="0,0,0,6"/>
                                <TextBlock Text="Conecta esta estación a una base centralizada (Supabase, Neon, VPS o Servidor Local) para sincronización instantánea de stock, ventas y precios." 
                                           FontSize="11" Foreground="#64748B" Margin="22,0,0,12"/>

                                <!-- PARÁMETROS POSTGRESQL -->
                                <Border Background="White" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="8" Padding="14" Margin="22,0,0,0"
                                        Visibility="{Binding EsModoPostgres, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="Parámetros del Servidor PostgreSQL:" FontSize="12" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,10"/>
                                        
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="Servidor / Host / Dominio:" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBox Text="{Binding Config.ServidorPostgres, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="6,4"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Puerto:" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBox Text="{Binding Config.PuertoPostgres, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="6,4"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Text="Nombre Base de Datos:" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBox Text="{Binding Config.BaseDatosPostgres, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="6,4"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                                <TextBlock Text="Usuario:" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBox Text="{Binding Config.UsuarioPostgres, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="6,4"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Contraseña:" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBox Text="{Binding Config.PasswordPostgres, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="6,4"/>
                                            </StackPanel>
                                        </Grid>

                                        <DockPanel LastChildFill="False" Margin="0,8,0,0">
                                            <Button Content="🔌 Probar Conexión" Command="{Binding ProbarConexionPostgresCommand}"
                                                    Background="#0284C7" Foreground="White" FontWeight="Bold" Padding="14,6" FontSize="12" Cursor="Hand" Margin="0,0,10,0"/>
                                            <Button Content="🚀 Migrar Datos Locales a la Nube (1 Clic)" Command="{Binding MigrarSqliteAPostgresCommand}"
                                                    Background="#16A34A" Foreground="White" FontWeight="Bold" Padding="14,6" FontSize="12" Cursor="Hand"/>
                                        </DockPanel>

                                        <TextBlock Text="{Binding MensajeConexionDb}" FontSize="11" FontWeight="Bold" Foreground="#0F172A" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ProgresoMigracionTexto}" FontSize="11" Foreground="#166534" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding EstaMigrandoBaseDatos, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- IDENTIDAD DE ESTA TERMINAL Y MANEJO DE CAJAS -->
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="🖥️ IDENTIDAD DE ESTA TERMINAL Y MANEJO DE CAJAS" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>

                                <TextBlock Text="Nombre / Identificador de esta Terminal:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Config.NombreTerminal, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Padding="8,6" Margin="0,0,0,12" MaxWidth="350" HorizontalAlignment="Left"/>

                                <TextBlock Text="Modalidad de Cajas y Turnos en Multi-PC:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <RadioButton Content="Caja Compartida / Turno Único (1 solo cajón de dinero compartido entre todas las PCs)" 
                                             IsChecked="{Binding EsCajaCompartida}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <RadioButton Content="Cajas Independientes (Cada terminal abre y cierra su propio turno con su cajón físico)" 
                                             IsChecked="{Binding EsCajaIndependiente}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 9: USUARIOS Y SEGURIDAD -->
            <TabItem Header="👥 Usuarios y Claves">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel MaxWidth="850" HorizontalAlignment="Left">
                        <TextBlock Text="SEGURIDAD Y CONTROL DE ACCESO DE USUARIOS" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
                        <TextBlock Text="Gestione las contraseñas personales de los operadores y cree nuevos usuarios/cajeros para el uso del sistema." 
                                   FontSize="12" Foreground="#64748B" Margin="0,0,0,16" TextWrapping="Wrap"/>

                        <!-- SECCIÓN 1: MI PERFIL Y CAMBIO DE CONTRASEÑA -->
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="🔑 CAMBIAR MI CONTRASEÑA" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6"/>
                                <TextBlock Text="Actualice su clave de ingreso personal al sistema." FontSize="11" Foreground="#64748B" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Contraseña Actual:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding PasswordActual, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="6,4"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="Nueva Contraseña:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding PasswordNueva, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="6,4"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Repetir Nueva Contraseña:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding PasswordNuevaConfirmacion, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="6,4"/>
                                    </StackPanel>
                                </Grid>

                                <DockPanel LastChildFill="False">
                                    <Button Content="🔐 Actualizar Mi Contraseña" Command="{Binding CambiarMiPasswordCommand}"
                                            Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="16,6" FontSize="12" Cursor="Hand"/>
                                </DockPanel>

                                <TextBlock Text="{Binding MensajePassword}" FontSize="12" FontWeight="Bold" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Foreground="#16A34A"/>
                            </StackPanel>
                        </Border>

                        <!-- SECCIÓN 2: ADMINISTRACIÓN DE USUARIOS Y CAJEROS (SOLO ADMINS) -->
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="10" Padding="16" Margin="0,0,0,16"
                                Visibility="{Binding EsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="👥 ADMINISTRACIÓN DE USUARIOS Y CAJEROS" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6"/>
                                <TextBlock Text="Cree usuarios independientes para cada cajero o personal del negocio. En Multi-PC, los usuarios se sincronizan automáticamente en todas las terminales." FontSize="11" Foreground="#64748B" Margin="0,0,0,12"/>

                                <!-- FORMULARIO NUEVO USUARIO -->
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="➕ Dar de alta un nuevo usuario / cajero:" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>
                                        
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="140"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="Usuario (Login):" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                                <TextBox Text="{Binding NuevoUsername, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="6,4"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                <TextBlock Text="Nombre Completo:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                                <TextBox Text="{Binding NuevoNombreCompleto, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="6,4"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                                <TextBlock Text="Contraseña Inicial:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                                <TextBox Text="{Binding NuevoPasswordUsuario, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="6,4"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3">
                                                <TextBlock Text="Rol:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                                <ComboBox ItemsSource="{Binding RolesDisponibles}" SelectedItem="{Binding NuevoRolUsuario}" FontSize="12" Padding="6,4"/>
                                            </StackPanel>
                                        </Grid>

                                        <DockPanel LastChildFill="False">
                                            <Button Content="➕ Crear Usuario" Command="{Binding CrearNuevoUsuarioCommand}"
                                                    Background="#16A34A" Foreground="White" FontWeight="Bold" Padding="16,6" FontSize="12" Cursor="Hand"/>
                                        </DockPanel>

                                        <TextBlock Text="{Binding MensajeUsuarioCrud}" FontSize="12" FontWeight="Bold" Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Foreground="#16A34A"/>
                                    </StackPanel>
                                </Border>

                                <!-- GRILLA DE USUARIOS EXISTENTES -->
                                <TextBlock Text="Usuarios Activos en el Sistema:" FontSize="12" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>
                                <DataGrid ItemsSource="{Binding Usuarios}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          Height="180"
                                          RowHeight="36"
                                          FontSize="12">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Usuario" Binding="{Binding Username}" Width="140" FontWeight="SemiBold"/>
                                        <DataGridTextColumn Header="Nombre Completo" Binding="{Binding NombreCompleto}" Width="*"/>
                                        <DataGridTextColumn Header="Rol Asignado" Binding="{Binding Rol}" Width="140"/>
                                        <DataGridTemplateColumn Header="Acción" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="🗑️ Desactivar" Command="{Binding DataContext.EliminarUsuarioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Background="#FEE2E2" Foreground="#DC2626" FontWeight="SemiBold" Padding="8,4" FontSize="11" Cursor="Hand" ToolTip="Desactivar usuario"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>


        <!-- Barra Inferior de Estado -->
        <TextBlock Grid.Row="2" Text="{Binding MensajeGuardado}" Foreground="#16A34A" FontWeight="Bold" FontSize="13" Margin="0,10,0,0"/>
    </Grid>
</UserControl>
