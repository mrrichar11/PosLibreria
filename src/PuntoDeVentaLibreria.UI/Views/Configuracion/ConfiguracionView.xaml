<UserControl x:Class="PuntoDeVentaLibreria.UI.Views.Configuracion.ConfiguracionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:PuntoDeVentaLibreria.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="CONFIGURACIÓN DEL SISTEMA" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Ajustes de comercio, finanzas, tickets, backups, licencia y actualizaciones" FontSize="12" Foreground="#64748B"/>
            </StackPanel>

            <Button Grid.Column="1" Content="💾 Guardar Cambios" Command="{Binding GuardarConfiguracionCommand}"
                    Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="20,10" FontSize="14" Cursor="Hand"/>
        </Grid>

        <!-- Pestañas de Configuración -->
        <TabControl Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
            <!-- TAB 1: DATOS DEL COMERCIO -->
            <TabItem Header="🏬 Datos del Comercio">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel MaxWidth="700" HorizontalAlignment="Left">
                        <TextBlock Text="INFORMACIÓN GENERAL DEL NEGOCIO" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>

                        <TextBlock Text="Nombre Comercial de la Librería:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Config.NombreComercio, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8,6" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="CUIT / Identificación Tributaria:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Config.Cuit, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8,6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Teléfono / WhatsApp:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Config.Telefono, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8,6"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Dirección / Domicilio del Local:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Config.Direccion, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8,6" Margin="0,0,0,12"/>

                        <TextBlock Text="Vendedora / Cajero por Defecto:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Config.VendedoraDefecto, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8,6" Margin="0,0,0,14"/>

                        <!-- PAÍS, MONEDA Y BILLETES EN CIRCULACIÓN -->
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="🌍 PAÍS, MONEDA Y BILLETES EN CIRCULACIÓN" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
                                <TextBlock Text="Configura el país y los billetes rápidos que aparecerán en la ventana de cobro en efectivo." 
                                           FontSize="11" Foreground="#64748B" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Selector de País -->
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="País o Región:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="CmbPais" ItemsSource="{Binding PaisesDisponibles}" 
                                                  SelectedItem="{Binding Config.Pais, Mode=TwoWay}"
                                                  SelectionChanged="CmbPais_SelectionChanged"
                                                  FontSize="14" Padding="8,6"/>
                                    </StackPanel>

                                    <!-- Símbolo de Moneda -->
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Símbolo Moneda:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding Config.SimboloMoneda, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8,6"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Billetes Habilitados CSV -->
                                <TextBlock Text="Billetes en Circulación (separados por coma):" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Config.BilletesHabilitados, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8,6" Margin="0,0,0,6"/>
                                <TextBlock Text="💡 Ej: 100,200,500,1000,2000,10000,20000 (sin billete de 5000 para Argentina)" FontSize="11" Foreground="#475569"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: FINANZAS & MEDIOS DE PAGO -->
            <TabItem Header="💳 Finanzas &amp; Pagos">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel MaxWidth="700" HorizontalAlignment="Left">
                        <TextBlock Text="POLÍTICAS DE PRECIOS Y MEDIOS DE PAGO" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Descuento en Efectivo (%):" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Config.PorcentajeDescuentoEfectivo, UpdateSourceTrigger=PropertyChanged, StringFormat='N1'}" FontSize="14" Padding="8,6"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Margen Ganancia Sugerido (%):" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Config.MargenGananciaSugerido, UpdateSourceTrigger=PropertyChanged, StringFormat='N1'}" FontSize="14" Padding="8,6"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Cuotas y Tarjetas:" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,8,0,8"/>

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <CheckBox Content="Habilitar Plan 3 Cuotas" IsChecked="{Binding Config.Habilitar3Cuotas}" FontWeight="Bold" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Recargo 3 Cuotas (%):" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Width="100" Text="{Binding Config.Recargo3Cuotas, UpdateSourceTrigger=PropertyChanged, StringFormat='N1'}" Padding="6,4"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <CheckBox Content="Habilitar Plan 6 Cuotas" IsChecked="{Binding Config.Habilitar6Cuotas}" FontWeight="Bold" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Recargo 6 Cuotas (%):" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Width="100" Text="{Binding Config.Recargo6Cuotas, UpdateSourceTrigger=PropertyChanged, StringFormat='N1'}" Padding="6,4"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Tope Mensual de Retiros de Dueño ($):" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding Config.TopeMensualRetiroDueño, UpdateSourceTrigger=PropertyChanged, StringFormat='N2'}" FontSize="14" Padding="8,6"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: TICKETS & IMPRESIÓN -->
            <TabItem Header="🖨 Tickets &amp; Impresión">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="CONFIGURACIÓN DE TICKETS TÉRMICOS" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>

                        <!-- Impresora -->
                        <TextBlock Text="Impresora Térmica Instalada en Windows:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding ImpresorasDisponibles}" SelectedItem="{Binding Config.ImpresoraTickets}"
                                  FontSize="13" Padding="8,6" Margin="0,0,0,4"/>
                        <TextBlock Text="Deje en blanco o elija su impresora térmica. Si se deja en blanco, Windows preguntará la impresora al imprimir." FontSize="11" Foreground="#64748B" Margin="0,0,0,16"/>

                        <!-- Ancho de Papel -->
                        <TextBlock Text="Ancho de Papel Térmico:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <RadioButton Content="80 mm (Estándar Mostrador - 44 columnas)" IsChecked="{Binding EsPapel80Mm}" Margin="0,0,24,0" FontWeight="SemiBold"/>
                            <RadioButton Content="58 mm (Compacto de Mano - 32 columnas)" IsChecked="{Binding EsPapel58Mm}" FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- Opciones de Flujo de Venta -->
                        <TextBlock Text="Comportamiento en Punto de Venta:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <CheckBox Content="Mostrar siempre la vista previa en pantalla al finalizar el cobro"
                                          IsChecked="{Binding Config.MostrarVistaPreviaTicket}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <CheckBox Content="Mandar a imprimir automáticamente al confirmar la venta"
                                          IsChecked="{Binding Config.ImprimirAutomaticoAlCobrar}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- Mensaje de Pie de Ticket -->
                        <TextBlock Text="Mensaje de Pie / Políticas de Cambio del Ticket:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Config.MensajePieTicket, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="75"
                                 FontSize="13" Padding="8,6" Margin="0,0,0,4"/>
                        <TextBlock Text="Aparecerá centrado al final de cada comprobante. Puede usar varias líneas (Enter)." FontSize="11" Foreground="#64748B" Margin="0,0,0,20"/>

                        <!-- Botonera de Pruebas y Guardado -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="👁 Ver Vista Previa de Prueba" Command="{Binding ProbarVistaPreviaTicketCommand}"
                                    Background="#2563EB" Foreground="White" Padding="16,8" FontWeight="Bold" Cursor="Hand" Margin="0,0,10,0"/>

                            <Button Content="📄 Imprimir Ticket de Prueba" Command="{Binding ProbarTicketCommand}"
                                    Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Padding="14,8" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,10,0"/>

                            <Button Content="💾 Guardar Cambios de Ticket" Command="{Binding GuardarConfiguracionCommand}"
                                    Background="#16A34A" Foreground="White" Padding="16,8" FontWeight="Bold" Cursor="Hand"/>
                        </StackPanel>

                        <TextBlock Text="💡 Nota: Todas las ventas generan automáticamente una copia de auditoría en la carpeta ./Tickets/" FontSize="12" Foreground="#64748B"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: APARIENCIA & TEMA -->
            <TabItem Header="🎨 Apariencia &amp; Tema">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel MaxWidth="700" HorizontalAlignment="Left">
                        <TextBlock Text="SELECCIÓN DEL TEMA VISUAL FLUENT" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>
                        <TextBlock Text="Elija el contraste que prefiera para trabajar en mostrador:" FontSize="12" Foreground="#64748B" Margin="0,0,0,16"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <!-- Modo Claro -->
                            <Button Command="{Binding CambiarTemaCommand}" CommandParameter="Light"
                                    Width="180" Height="100" Margin="0,0,16,0" Padding="10" Cursor="Hand" Background="White" BorderBrush="#CBD5E1" BorderThickness="2">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="☀️" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="Modo Claro" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Foreground="#0F172A"/>
                                    <TextBlock Text="Fondo luminoso" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Modo Oscuro -->
                            <Button Command="{Binding CambiarTemaCommand}" CommandParameter="Dark"
                                    Width="180" Height="100" Padding="10" Cursor="Hand" Background="#0F172A" BorderBrush="#334155" BorderThickness="2">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="🌙" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="Modo Oscuro" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Foreground="White"/>
                                    <TextBlock Text="Alto contraste" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 5: PLAN MENSUAL & LICENCIA -->
            <TabItem Header="🔑 Plan Mensual &amp; Licencia">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel MaxWidth="700" HorizontalAlignment="Left">
                        <TextBlock Text="ESTADO DE LA SUSCRIPCIÓN" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>

                        <!-- Estado Actual Card -->
                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding EstadoLicencia.PlanNombre}" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                    <Border Grid.Column="1" Background="#2563EB" CornerRadius="6" Padding="8,4">
                                        <TextBlock Text="{Binding EstadoLicencia.DiasRestantes, StringFormat='{}{0} DÍAS RESTANTES'}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding EstadoLicencia.Mensaje}" FontSize="12" Foreground="#475569" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding EstadoLicencia.CodigoInstalacion, StringFormat='ID de Máquina: {0}'}" FontFamily="Consolas" FontSize="12" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>

                        <!-- Input Clave de Activación -->
                        <TextBlock Text="Activar o Renovar Plan Mensual:" FontSize="13" FontWeight="Bold" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding ClaveActivacionInput, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="14" FontFamily="Consolas" Padding="8,6" Margin="0,0,10,0"/>
                            <Button Grid.Column="1" Content="✔ Activar Clave" Command="{Binding ActivarLicenciaCommand}"
                                    Background="#16A34A" Foreground="White" FontWeight="Bold" Padding="16,8" Cursor="Hand"/>
                        </Grid>

                        <TextBlock Text="{Binding MensajeActivacion}" FontWeight="Bold" Foreground="#2563EB" FontSize="12"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 6: ACTUALIZACIONES -->
            <!-- TAB 6: ACTUALIZACIONES -->
            <TabItem Header="🚀 Actualizaciones">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="ACTUALIZACIONES OFICIALES Y REPOSITORIO GITHUB" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
                        <TextBlock Text="Configure el repositorio de distribución y compruebe nuevas versiones del software en 1 clic." FontSize="12" Foreground="#64748B" Margin="0,0,0,16"/>

                        <!-- CONFIGURACION DE REPOSITORIO GITHUB -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Repositorio Oficial de Distribución (GitHub Releases)" FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>
                                
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Usuario / Organización GitHub:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding Config.GitHubRepoOwner, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Padding="8,6"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Nombre del Repositorio:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding Config.GitHubRepoName, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Padding="8,6"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="💡 El sistema consultará automáticamente este repositorio público para detectar nuevas versiones y descargar paquetes de actualización." FontSize="11" Foreground="#64748B"/>
                            </StackPanel>
                        </Border>

                        <!-- ESTADO ACTUAL Y BUSQUEDA -->
                        <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <DockPanel LastChildFill="True" Margin="0,0,0,12">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="Versión Actualmente Instalada:" FontSize="12" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding ActualizacionInfo.VersionActual, StringFormat='v{0}'}" FontSize="18" FontWeight="Black" Foreground="#0F172A"/>
                                    </StackPanel>
                                    
                                    <Button DockPanel.Dock="Right" Content="🔄 Buscar Nueva Versión Ahora" Command="{Binding BuscarActualizacionesCommand}"
                                            Padding="16,8" FontWeight="Bold" Background="#2563EB" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"/>
                                </DockPanel>

                                <TextBlock Text="{Binding MensajeActualizacion}" FontSize="13" Foreground="#334155" FontWeight="SemiBold" Margin="0,0,0,8"/>

                                <!-- PANEL CUANDO HAY ACTUALIZACION DISPONIBLE -->
                                <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,8,0,0"
                                        Visibility="{Binding ActualizacionInfo.HayActualizacion, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <DockPanel LastChildFill="True" Margin="0,0,0,10">
                                            <StackPanel DockPanel.Dock="Left">
                                                <TextBlock Text="🎉 ¡NUEVA VERSIÓN OFICIAL DISPONIBLE!" FontSize="13" FontWeight="Bold" Foreground="#166534"/>
                                                <TextBlock Text="{Binding ActualizacionInfo.VersionDisponible, StringFormat='Nueva Versión: v{0}'}" FontSize="15" FontWeight="Black" Foreground="#15803D"/>
                                            </StackPanel>

                                            <Button DockPanel.Dock="Right" Content="🚀 Ver Novedades e Instalar en 1 Clic" Command="{Binding AbrirVentanaActualizacionCommand}"
                                                    Background="#16A34A" Foreground="White" FontWeight="Bold" Padding="16,8" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"/>
                                        </DockPanel>

                                        <!-- Notas del lanzamiento -->
                                        <TextBlock Text="Novedades incluidas:" FontSize="11" FontWeight="Bold" Foreground="#14532D" Margin="0,0,0,4"/>
                                        <Border Background="White" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="8" MaxHeight="100">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <TextBlock Text="{Binding ActualizacionInfo.NotasLanzamiento}" FontSize="11" Foreground="#374151" TextWrapping="Wrap"/>
                                            </ScrollViewer>
                                        </Border>

                                        <!-- Progreso de descarga si se hace inline -->
                                        <ProgressBar Value="{Binding ProgresoDescarga}" Height="8" Margin="0,10,0,0"
                                                     Visibility="{Binding EstaDescargandoActualizacion, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- GARANTIA DE BASE DE DATOS -->
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="🛡️" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Protección Total de Datos: Antes de cualquier actualización, el sistema genera automáticamente una copia de seguridad de la base de datos (punto_venta_libreria.db) y descarta cualquier base incluida en el paquete para proteger completamente sus ventas, stock y clientes." 
                                           FontSize="11" Foreground="#1E40AF" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 7: COPIAS DE SEGURIDAD -->
            <TabItem Header="🛡 Copias de Seguridad">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel HorizontalAlignment="Stretch">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="RESPALDO SEGURO DE LA BASE DE DATOS (SQLITE)" FontSize="14" FontWeight="Bold" Foreground="#1E293B"/>
                                <TextBlock Text="Las copias son atómicas y protegen todas sus ventas, artículos y clientes" FontSize="12" Foreground="#64748B"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="💾 Crear Copia de Seguridad Ahora" Command="{Binding CrearBackupAhoraCommand}"
                                    Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="16,8" Cursor="Hand"/>
                        </Grid>

                        <TextBlock Text="{Binding MensajeBackup}" FontWeight="Bold" Foreground="#16A34A" FontSize="12" Margin="0,0,0,12"/>

                        <!-- Historial -->
                        <TextBlock Text="Copias de Seguridad Disponibles:" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,8,0,8"/>
                        <DataGrid ItemsSource="{Binding HistorialBackups}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  Height="240"
                                  RowHeight="36"
                                  FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Archivo de Copia" Binding="{Binding NombreArchivo}" Width="*"/>
                                <DataGridTextColumn Header="Fecha / Hora" Binding="{Binding FechaCreacion, StringFormat='dd/MM/yyyy HH:mm'}" Width="150"/>
                                <DataGridTextColumn Header="Tamaño" Binding="{Binding TamañoFormateado}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Barra Inferior de Estado -->
        <TextBlock Grid.Row="2" Text="{Binding MensajeGuardado}" Foreground="#16A34A" FontWeight="Bold" FontSize="13" Margin="0,10,0,0"/>
    </Grid>
</UserControl>
