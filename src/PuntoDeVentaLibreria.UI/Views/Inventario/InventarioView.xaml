<UserControl x:Class="PuntoDeVentaLibreria.UI.Views.Inventario.InventarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:PuntoDeVentaLibreria.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <UserControl.Resources>
        <conv:StockToBrushConverter x:Key="StockBrushConv"/>
        <conv:StockToBadgeBackgroundConverter x:Key="StockBadgeBgConv"/>
        <conv:StockToEstadoTextoConverter x:Key="StockTextoConv"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabecera y Métricas Rápidas -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="INVENTARIO &amp; ARTÍCULOS DE LIBRERÍA" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Control de stock de útiles, repuestos, libros y combos escolares" FontSize="12" Foreground="#64748B"/>
            </StackPanel>

            <!-- Card Total Artículos -->
            <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,8" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="TOTAL ARTÍCULOS" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock Text="{Binding TotalArticulos}" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                </StackPanel>
            </Border>

            <!-- Card Valor Total Stock -->
            <Border Grid.Column="2" Background="#0F172A" CornerRadius="10" Padding="16,8">
                <StackPanel>
                    <TextBlock Text="VALOR TOTAL STOCK" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                    <TextBlock Text="{Binding ValorTotalStock, StringFormat='${0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="#38BDF8"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Barra de Búsqueda y Botonera -->
        <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,14">
            <StackPanel>
                <!-- Fila 1: Búsqueda y Acciones Rápidas -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtBuscar" Grid.Column="0" Text="{Binding CriterioBusqueda, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14" Padding="10,6" BorderBrush="#CBD5E1" Margin="0,0,10,0"
                             VerticalAlignment="Center"/>

                    <Button Grid.Column="1" Content="🔍 Buscar" Command="{Binding BuscarCommand}"
                            Padding="16,8" FontWeight="SemiBold" Margin="0,0,10,0" Cursor="Hand"/>

                    <Button Grid.Column="2" Content="➕ Nuevo Artículo / Útil" Command="{Binding NuevoArticuloCommand}"
                            Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="18,8" Cursor="Hand"/>
                </Grid>

                <!-- Fila 2: Herramientas Masivas de Librería -->
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button Content="🚀 Migrar Catálogo (Alma Libre)" Click="BtnMigrarAlmaLibre_Click"
                                Background="#ECFDF5" Foreground="#047857" BorderBrush="#A7F3D0" BorderThickness="1.5"
                                Padding="12,6" FontWeight="Bold" FontSize="12" Margin="0,0,8,0" Cursor="Hand"
                                ToolTip="Importe masivamente los 2.800+ artículos desde el Excel de Alma Libre"/>

                        <Button Content="📈 Actualizar Precios (El Once)" Click="BtnActualizarPrecios_Click"
                                Background="#F5F3FF" Foreground="#6D28D9" BorderBrush="#DDD6FE" BorderThickness="1.5"
                                Padding="12,6" FontWeight="Bold" FontSize="12" Margin="0,0,8,0" Cursor="Hand"
                                ToolTip="Actualice costos y precios en lote según la lista de precios descargada del proveedor El Once"/>

                        <Button Content="🏭 Proveedores" Click="BtnProveedores_Click"
                                Background="#F8FAFC" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1"
                                Padding="12,6" FontWeight="SemiBold" FontSize="12" Margin="0,0,8,0" Cursor="Hand"
                                ToolTip="Administrar lista de proveedores y distribuidores de librería"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="📤 Exportar CSV" Command="{Binding ExportarCsvCommand}"
                                Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10,6" FontSize="12" FontWeight="SemiBold" Margin="0,0,6,0" Cursor="Hand"
                                ToolTip="Exportar todo el catálogo para abrir o editar en Excel"/>

                        <Button Content="📥 Importar CSV" Command="{Binding ImportarCsvCommand}"
                                Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10,6" FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                                ToolTip="Cargar o actualizar artículos masivamente desde archivo CSV genérico"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Grilla de Artículos -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
            <DataGrid ItemsSource="{Binding Articulos}"
                      SelectedItem="{Binding ArticuloSeleccionado}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F1F5F9"
                      RowHeight="44"
                      FontSize="13"
                      Background="White"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Código / ISBN" Binding="{Binding CodigoBarras}" Width="120"/>
                    <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="95"/>
                    <DataGridTextColumn Header="Cód. Prov." Binding="{Binding CodigoProveedor}" Width="85"/>
                    <DataGridTextColumn Header="Descripción del Artículo / Útil" Binding="{Binding Nombre}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Proveedor" Binding="{Binding ProveedorNombre}" Width="105"/>
                    <DataGridTextColumn Header="Ubicación" Binding="{Binding Ubicacion}" Width="95"/>
                    <DataGridTextColumn Header="P. Costo" Binding="{Binding PrecioCosto, StringFormat='${0:N2}'}" Width="90"/>
                    <DataGridTextColumn Header="P. Venta" Binding="{Binding PrecioVenta, StringFormat='${0:N2}'}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#0369A1"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <!-- Stock Actual con Alerta Visual de Color -->
                    <DataGridTemplateColumn Header="Stock Actual" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Converter={StaticResource StockBadgeBgConv}}" 
                                        BorderBrush="{Binding Converter={StaticResource StockBrushConv}}" 
                                        BorderThickness="1" CornerRadius="6" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StockActual, StringFormat='N0'}" FontWeight="Bold" FontSize="12"
                                                   Foreground="{Binding Converter={StaticResource StockBrushConv}}" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding Converter={StaticResource StockTextoConv}, StringFormat='({0})'}" 
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{Binding Converter={StaticResource StockBrushConv}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Mínimo" Binding="{Binding StockMinimo, StringFormat='N0'}" Width="75"/>

                    <!-- Acciones -->
                    <DataGridTemplateColumn Header="Acción" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="✏ Editar" Padding="6,2" Cursor="Hand"
                                        Command="{Binding DataContext.EditarArticuloCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
