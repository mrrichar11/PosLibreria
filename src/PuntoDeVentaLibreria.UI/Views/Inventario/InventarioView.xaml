<UserControl x:Class="PuntoDeVentaLibreria.UI.Views.Inventario.InventarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:PuntoDeVentaLibreria.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <UserControl.Resources>
        <conv:StockToBrushConverter x:Key="StockBrushConv"/>
        <conv:StockToBadgeBackgroundConverter x:Key="StockBadgeBgConv"/>
        <conv:StockToEstadoTextoConverter x:Key="StockTextoConv"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera y Métricas Rápidas -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="INVENTARIO &amp; ARTÍCULOS DE LIBRERÍA" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextoTituloBrush}"/>
                <TextBlock Text="Control de stock de útiles, repuestos, libros y combos escolares" FontSize="12" Foreground="{DynamicResource TextoSubtituloBrush}"/>
            </StackPanel>

            <!-- Card Total Artículos -->
            <Border Grid.Column="1" Background="{DynamicResource FondoTarjetaBrush}" BorderBrush="{DynamicResource BordeTarjetaBrush}" BorderThickness="1" CornerRadius="10" Padding="14,8" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="TOTAL ARTÍCULOS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextoSubtituloBrush}"/>
                    <TextBlock Text="{Binding TotalArticulos}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextoTituloBrush}"/>
                </StackPanel>
            </Border>

            <!-- Card Valor Total Stock -->
            <Border Grid.Column="2" Background="#0F172A" CornerRadius="10" Padding="16,8">
                <StackPanel>
                    <TextBlock Text="VALOR TOTAL STOCK" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                    <TextBlock Text="{Binding ValorTotalStock, StringFormat='${0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="#38BDF8"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Barra de Búsqueda y Botonera -->
        <Border Grid.Row="1" Background="{DynamicResource FondoTarjetaBrush}" BorderBrush="{DynamicResource BordeTarjetaBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,14">
            <StackPanel>
                <!-- Fila 1: Búsqueda y Acciones Rápidas -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtBuscar" Grid.Column="0" Text="{Binding CriterioBusqueda, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14" Padding="10,6" BorderBrush="#CBD5E1" Margin="0,0,10,0"
                             VerticalAlignment="Center" KeyDown="TxtBuscar_KeyDown"/>

                    <Button Grid.Column="1" Content="🔍 Buscar" Command="{Binding BuscarCommand}"
                            Padding="16,8" FontWeight="SemiBold" Margin="0,0,10,0" Cursor="Hand"/>

                    <Button Grid.Column="2" Content="➕ Nuevo Artículo / Útil" Command="{Binding NuevoArticuloCommand}"
                            Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="18,8" Cursor="Hand"/>
                </Grid>

                <!-- Fila 2: Herramientas Masivas de Librería -->
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button Content="🚀 Importar / Migrar Catálogo (Excel)" Click="BtnMigrarAlmaLibre_Click"
                                Background="#ECFDF5" Foreground="#047857" BorderBrush="#A7F3D0" BorderThickness="1.5"
                                Padding="12,6" FontWeight="Bold" FontSize="12" Margin="0,0,8,0" Cursor="Hand"
                                ToolTip="Importador universal: cargue listas de precios o catálogos Excel de cualquier sistema anterior con mapeo de columnas y control de stock"/>


                        <Button Content="📈 Actualizar Precios por Proveedor" Click="BtnActualizarPrecios_Click"
                                Background="#F5F3FF" Foreground="#6D28D9" BorderBrush="#DDD6FE" BorderThickness="1.5"
                                Padding="12,6" FontWeight="Bold" FontSize="12" Margin="0,0,8,0" Cursor="Hand"
                                ToolTip="Actualice costos y precios en lote según la lista de precios descargada de cualquier proveedor"/>

                        <Button Content="📋 Conteo / Auditoría de Stock" Click="BtnConteoStock_Click"
                                Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#BFDBFE" BorderThickness="1.5"
                                Padding="12,6" FontWeight="Bold" FontSize="12" Margin="0,0,8,0" Cursor="Hand"
                                ToolTip="Auditar y contar existencias físicas por góndola o estantería con escáner"/>

                        <Button Content="🏭 Proveedores" Click="BtnProveedores_Click"
                                Background="#F8FAFC" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1"
                                Padding="12,6" FontWeight="SemiBold" FontSize="12" Margin="0,0,8,0" Cursor="Hand"
                                ToolTip="Administrar lista de proveedores y distribuidores de librería"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="📤 Exportar CSV" Command="{Binding ExportarCsvCommand}"
                                Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10,6" FontSize="12" FontWeight="SemiBold" Margin="0,0,6,0" Cursor="Hand"
                                ToolTip="Exportar todo el catálogo para abrir o editar en Excel"/>

                        <Button Content="📥 Importar CSV" Command="{Binding ImportarCsvCommand}"
                                Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10,6" FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                                ToolTip="Cargar o actualizar artículos masivamente desde archivo CSV genérico"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Grilla de Artículos -->
        <Border Grid.Row="2" Background="{DynamicResource FondoDataGridBrush}" BorderBrush="{DynamicResource BordeTarjetaBrush}" BorderThickness="1" CornerRadius="10">
            <DataGrid ItemsSource="{Binding Articulos}"
                      SelectedItem="{Binding ArticuloSeleccionado}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource HorizontalGridLinesBrush}"
                      RowHeight="44"
                      FontSize="13"
                      Background="{DynamicResource FondoDataGridBrush}"
                      RowBackground="{DynamicResource FondoDataGridBrush}"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Código / ISBN" Binding="{Binding CodigoBarras}" Width="120"/>
                    <DataGridTextColumn Header="Rubro" Binding="{Binding Rubro}" Width="90"/>
                    <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="95"/>
                    <DataGridTextColumn Header="Cód. Prov." Binding="{Binding CodigoProveedor}" Width="85"/>
                    <DataGridTemplateColumn Header="Descripción del Artículo / Útil" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="4,2">
                                    <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextoNormalBrush}"/>
                                    <TextBlock Text="{Binding Descripcion, StringFormat='(Prov: {0})', TargetNullValue=''}" 
                                               FontSize="10.5" Foreground="{DynamicResource TextoSubtituloBrush}" FontStyle="Italic" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Visibility="{Binding TieneVariantes, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="4" 
                                                Padding="5,1" Margin="0,3,6,0" HorizontalAlignment="Left"
                                                ToolTip="{Binding VariantesResumenTexto}">
                                            <TextBlock Text="{Binding VariantesResumenTexto}" FontSize="10.5" Foreground="#3730A3" FontWeight="SemiBold" MaxWidth="380" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                        <Border Visibility="{Binding EsPrecioDolar, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="4" 
                                                Padding="5,1" Margin="0,3,0,0" HorizontalAlignment="Left"
                                                ToolTip="Costo pactado en dólares estadounidenses">
                                            <TextBlock Text="{Binding PrecioCostoDolar, StringFormat='USD ${0:N2}'}" FontSize="10" Foreground="#15803D" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Proveedor" Binding="{Binding ProveedorNombre}" Width="105"/>
                    <DataGridTextColumn Header="Ubicación" Binding="{Binding Ubicacion}" Width="95"/>
                    <DataGridTextColumn Header="P. Costo" Binding="{Binding PrecioCosto, StringFormat='${0:N2}'}" Width="90"/>
                    <DataGridTextColumn Header="P. Venta" Binding="{Binding PrecioVenta, StringFormat='${0:N2}'}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#0369A1"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <!-- Stock Actual con Alerta Visual de Color -->
                    <DataGridTemplateColumn Header="Stock Actual" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Converter={StaticResource StockBadgeBgConv}}" 
                                        BorderBrush="{Binding Converter={StaticResource StockBrushConv}}" 
                                        BorderThickness="1" CornerRadius="6" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StockActual, StringFormat='N0'}" FontWeight="Bold" FontSize="12"
                                                   Foreground="{Binding Converter={StaticResource StockBrushConv}}" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding Converter={StaticResource StockTextoConv}, StringFormat='({0})'}" 
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{Binding Converter={StaticResource StockBrushConv}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Mínimo" Binding="{Binding StockMinimo, StringFormat='N0'}" Width="75"/>

                    <!-- Acciones -->
                    <DataGridTemplateColumn Header="Acciones" Width="145">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="✏ Editar" Padding="6,2" Margin="0,0,4,0" Cursor="Hand" FontSize="11"
                                            Background="#F1F5F9" Foreground="#1E293B" BorderBrush="#CBD5E1"
                                            Command="{Binding DataContext.EditarArticuloCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="🗑️" Padding="6,2" Cursor="Hand" FontSize="11"
                                            Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" ToolTip="Eliminar este artículo"
                                            Command="{Binding DataContext.EliminarArticuloCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Barra de Paginación y Control de Registros -->
        <Border Grid.Row="3" Background="{DynamicResource FondoTarjetaBrush}" BorderBrush="{DynamicResource BordeTarjetaBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
            <DockPanel LastChildFill="False">
                <!-- Información de registros a la izquierda y Filtro rápido por Rubro -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TextoPaginacion}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextoTituloBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <Border Background="{DynamicResource FondoControlSecundarioBrush}" BorderBrush="{DynamicResource BordeTarjetaBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Rubro:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextoSubtituloBrush}" VerticalAlignment="Center" Margin="2,0,6,0"/>
                            <ComboBox SelectedValue="{Binding RubroSeleccionado, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      SelectionChanged="CmbRubro_SelectionChanged"
                                      FontSize="11.5" Padding="6,2" MinWidth="110">
                                <ComboBoxItem Content="Todos" Tag="Todos" IsSelected="True"/>
                                <ComboBoxItem Content="📚 Librería" Tag="Librería"/>
                                <ComboBoxItem Content="🎁 Regalería" Tag="Regalería"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Selector de cantidad por página y botones de navegación a la derecha -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="Por pág:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextoSubtituloBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbPorPagina" SelectionChanged="CmbPorPagina_SelectionChanged" FontSize="11.5" Padding="6,2" Margin="0,0,16,0" MinWidth="75">
                        <ComboBoxItem Content="50" IsSelected="True"/>
                        <ComboBoxItem Content="100"/>
                        <ComboBoxItem Content="250"/>
                        <ComboBoxItem Content="500"/>
                        <ComboBoxItem Content="Todos"/>
                    </ComboBox>

                    <!-- Botones de Navegación -->
                    <Button Content="⏮" ToolTip="Primera página" Command="{Binding PrimeraPaginaCommand}" 
                            IsEnabled="{Binding PuedeIrAnterior}" Background="{DynamicResource FondoControlSecundarioBrush}" BorderBrush="{DynamicResource BordeTarjetaBrush}" BorderThickness="1" Foreground="{DynamicResource TextoNormalBrush}" Padding="8,4" Margin="0,0,4,0" Cursor="Hand"/>
                    <Button Content="◀ Anterior" Command="{Binding PaginaAnteriorCommand}" 
                            IsEnabled="{Binding PuedeIrAnterior}" Background="{DynamicResource FondoControlSecundarioBrush}" BorderBrush="{DynamicResource BordeTarjetaBrush}" BorderThickness="1" Foreground="{DynamicResource TextoNormalBrush}" Padding="10,4" FontWeight="SemiBold" Margin="0,0,6,0" Cursor="Hand"/>

                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,6,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Pág. " FontSize="11.5" Foreground="#1E40AF"/>
                            <TextBlock Text="{Binding PaginaActual}" FontSize="12" FontWeight="Bold" Foreground="#1D4ED8"/>
                            <TextBlock Text=" de " FontSize="11.5" Foreground="#1E40AF"/>
                            <TextBlock Text="{Binding TotalPaginas}" FontSize="12" FontWeight="Bold" Foreground="#1D4ED8"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Siguiente ▶" Command="{Binding PaginaSiguienteCommand}" 
                            IsEnabled="{Binding PuedeIrSiguiente}" Background="{DynamicResource FondoControlSecundarioBrush}" BorderBrush="{DynamicResource BordeTarjetaBrush}" BorderThickness="1" Foreground="{DynamicResource TextoNormalBrush}" Padding="10,4" FontWeight="SemiBold" Margin="0,0,4,0" Cursor="Hand"/>
                    <Button Content="⏭" ToolTip="Última página" Command="{Binding UltimaPaginaCommand}" 
                            IsEnabled="{Binding PuedeIrSiguiente}" Background="{DynamicResource FondoControlSecundarioBrush}" BorderBrush="{DynamicResource BordeTarjetaBrush}" BorderThickness="1" Foreground="{DynamicResource TextoNormalBrush}" Padding="8,4" Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
