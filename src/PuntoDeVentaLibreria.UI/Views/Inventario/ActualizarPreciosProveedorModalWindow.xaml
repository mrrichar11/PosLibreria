<Window x:Class="PuntoDeVentaLibreria.UI.Views.Inventario.ActualizarPreciosProveedorModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Actualización Masiva de Precios de Mayorista / Proveedor" 
        Height="720" Width="1060"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Border Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="ACTUALIZACIÓN INTELIGENTE DE PRECIOS MAYORISTAS" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Cargue la lista de precios descargada del proveedor (ej. El Once) para comparar aumentos de costos y recalcular los precios de venta en segundos." FontSize="12" Foreground="#64748B"/>
            </StackPanel>
        </Border>

        <!-- Filtros y Selección de Archivo -->
        <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Archivo Excel -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Archivo de Precios Mayorista (.xls o .xlsx de El Once / Proveedor):" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="📁 Examinar..." Click="BtnExaminar_Click"
                                Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Padding="12,6" FontWeight="SemiBold" Cursor="Hand" Margin="6,0,0,0"/>
                        <TextBox x:Name="TxtRutaArchivo" IsReadOnly="True" FontSize="12.5" Padding="8,6" Background="#F8FAFC"/>
                    </DockPanel>
                </StackPanel>

                <!-- Proveedor -->
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Filtrar por Proveedor (Opcional):" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbProveedor" DisplayMemberPath="Nombre" SelectedValuePath="Id" FontSize="12.5" Padding="8,6"/>
                </StackPanel>

                <!-- Botón Comparar -->
                <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Bottom">
                    <Button x:Name="BtnComparar" Content="⚡ Comparar Precios" Click="BtnComparar_Click"
                            Background="#7C3AED" Foreground="White" FontWeight="Bold" Padding="16,8" Cursor="Hand"/>
                </StackPanel>

                <!-- Métricas -->
                <DockPanel x:Name="PnlMetricas" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0" Visibility="Collapsed" LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Border Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                            <TextBlock x:Name="TxtCoincidencias" Text="Artículos Coincidentes: 0" FontWeight="Bold" Foreground="#6D28D9" FontSize="12"/>
                        </Border>
                        <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                            <TextBlock x:Name="TxtConCambio" Text="Con Cambio de Costo: 0" FontWeight="Bold" Foreground="#B91C1C" FontSize="12"/>
                        </Border>
                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,4">
                            <TextBlock x:Name="TxtNoEncontrados" Text="No Encontrados en Local: 0" FontWeight="Bold" Foreground="#475569" FontSize="12"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Button Content="☑️ Marcar con cambios" Click="BtnMarcarTodos_Click" Background="Transparent" BorderThickness="0" Foreground="#2563EB" FontWeight="Bold" FontSize="11" Cursor="Hand" Margin="0,0,12,0"/>
                        <Button Content="◻️ Desmarcar todos" Click="BtnDesmarcarTodos_Click" Background="Transparent" BorderThickness="0" Foreground="#64748B" FontWeight="Bold" FontSize="11" Cursor="Hand"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- Tabla Comparativa -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
            <Grid>
                <DataGrid x:Name="GridComparativa" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                          RowHeight="36" FontSize="12" Background="White" BorderThickness="0">
                    <DataGrid.Columns>
                        <!-- Checkbox para aplicar -->
                        <DataGridCheckBoxColumn Header="Aplicar" Binding="{Binding Aplicar, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                        <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="90" FontWeight="SemiBold" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Cód. Prov." Binding="{Binding CodigoProveedor}" Width="85" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Código Barras" Binding="{Binding CodigoBarras}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Descripción del Artículo" Binding="{Binding Nombre}" Width="*" IsReadOnly="True"/>

                        <DataGridTextColumn Header="Costo Actual" Binding="{Binding CostoAnterior, StringFormat='${0:N2}'}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Costo Nuevo" Binding="{Binding CostoNuevo, StringFormat='${0:N2}'}" Width="95" FontWeight="Bold" Foreground="#B91C1C" IsReadOnly="True"/>

                        <DataGridTextColumn Header="Venta Actual" Binding="{Binding VentaAnterior, StringFormat='${0:N2}'}" Width="95" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Venta Nueva" Binding="{Binding VentaNueva, StringFormat='${0:N2}'}" Width="100" FontWeight="Black" Foreground="#0284C7" IsReadOnly="True"/>

                        <DataGridTextColumn Header="% Variación" Binding="{Binding VariacionPorcentaje, StringFormat='{}{0:+#0.0;-#0.0;0}%'}" Width="85" FontWeight="Bold" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="TxtEstadoVacio" Text="Seleccione el archivo descargado de El Once y presione 'Comparar Precios' para ver la comparativa de aumentos."
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="#94A3B8" FontWeight="Medium"/>
            </Grid>
        </Border>

        <!-- Barra de Progreso -->
        <ProgressBar x:Name="PbProgreso" Grid.Row="3" Height="8" Margin="0,10,0,0" IsIndeterminate="True" Visibility="Collapsed"/>

        <!-- Pie y Botones -->
        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <Button Content="Cerrar" Click="BtnCerrar_Click" Padding="16,8" FontSize="12" Cursor="Hand"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="TxtMensajeResultado" VerticalAlignment="Center" FontSize="12.5" FontWeight="Bold" Margin="0,0,16,0"/>
                <Button x:Name="BtnAplicarAumento" Content="💾 Actualizar Precios Seleccionados" Click="BtnAplicarAumento_Click"
                        Background="#7C3AED" Foreground="White" FontWeight="Bold" Padding="20,8" FontSize="13" Cursor="Hand" IsEnabled="False"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
