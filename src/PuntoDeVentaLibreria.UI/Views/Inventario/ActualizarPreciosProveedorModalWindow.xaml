<Window x:Class="PuntoDeVentaLibreria.UI.Views.Inventario.ActualizarPreciosProveedorModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Actualización Inteligente de Precios de Mayorista / Proveedor" 
        Height="720" Width="1180"
        MinHeight="560" MinWidth="950"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Border Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="ACTUALIZACIÓN INTELIGENTE DE PRECIOS DE PROVEEDORES" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Cargue la lista de precios descargada del proveedor para cotejar costos, conciliar bultos/packs mediante factores divisores y recalcular precios de venta al instante." FontSize="12" Foreground="#64748B"/>
            </StackPanel>
        </Border>

        <!-- Filtros, Selección de Archivo y Asignación de Proveedor -->
        <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Archivo Excel -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Archivo de Precios del Proveedor (.xls o .xlsx):" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="📁 Examinar..." Click="BtnExaminar_Click"
                                Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Padding="12,6" FontWeight="SemiBold" Cursor="Hand" Margin="6,0,0,0"/>
                        <TextBox x:Name="TxtRutaArchivo" IsReadOnly="True" FontSize="12.5" Padding="8,6" Background="#F8FAFC"/>
                    </DockPanel>
                </StackPanel>

                <!-- Proveedor -->
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Proveedor del Archivo:" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbProveedor" DisplayMemberPath="Nombre" SelectedValuePath="Id" FontSize="12.5" Padding="8,6" SelectionChanged="CmbProveedor_SelectionChanged"/>
                </StackPanel>

                <!-- Botón Comparar -->
                <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Bottom">
                    <Button x:Name="BtnComparar" Content="⚡ Comparar Precios" Click="BtnComparar_Click"
                            Background="#7C3AED" Foreground="White" FontWeight="Bold" Padding="16,8" Cursor="Hand"/>
                </StackPanel>

                <!-- Checkboxes de Asignación y Búsqueda -->
                <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkAsignarProveedor" Content="Asignar este proveedor a los artículos actualizados que no lo tengan" 
                              IsChecked="True" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,24,0"/>
                    <CheckBox x:Name="ChkSoloArticulosDelProveedor" Content="Buscar únicamente en artículos que ya tienen este proveedor asignado" 
                              IsChecked="False" Foreground="#64748B" VerticalAlignment="Center"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Métricas y Pestañas de Filtrado -->
        <Border x:Name="PnlMetricas" Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Resumen de Métricas -->
                <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,4">
                        <TextBlock x:Name="TxtTotalCatalogo" Text="Artículos en Catálogo: 0" FontWeight="SemiBold" Foreground="#334155" FontSize="11.5"/>
                    </Border>
                    <Border Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,4">
                        <TextBlock x:Name="TxtCoincidencias" Text="Coincidentes: 0" FontWeight="Bold" Foreground="#6D28D9" FontSize="11.5"/>
                    </Border>
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,4">
                        <TextBlock x:Name="TxtConCambio" Text="Con Variación: 0" FontWeight="Bold" Foreground="#1D4ED8" FontSize="11.5"/>
                    </Border>
                    <Border x:Name="BorderAlertas" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,4">
                        <TextBlock x:Name="TxtConAlerta" Text="⚠️ Posibles Bultos/Packs: 0" FontWeight="Bold" Foreground="#B91C1C" FontSize="11.5"/>
                    </Border>
                    <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,4">
                        <TextBlock x:Name="TxtNoEncontrados" Text="Filas sin asociar en local: 0" FontWeight="SemiBold" Foreground="#475569" FontSize="11.5"/>
                    </Border>
                </WrapPanel>

                <!-- Botones de Vista / Filtro Rápido y Acciones Masivas -->
                <DockPanel Grid.Row="1" LastChildFill="False">
                    <!-- Segmented View Filter -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <RadioButton x:Name="RbFiltroTodos" Content="Mostrar Todos" IsChecked="True" Checked="FiltroRadio_Checked" 
                                     Style="{StaticResource {x:Type ToggleButton}}" Padding="10,4" FontWeight="SemiBold" FontSize="11" Margin="0,0,4,0"/>
                        <RadioButton x:Name="RbFiltroAlertas" Content="⚠️ Alertas / Posibles Packs" Checked="FiltroRadio_Checked" 
                                     Style="{StaticResource {x:Type ToggleButton}}" Padding="10,4" FontWeight="Bold" FontSize="11" Margin="0,0,4,0" Foreground="#DC2626"/>
                        <RadioButton x:Name="RbFiltroConCambio" Content="📈 Variación Normal" Checked="FiltroRadio_Checked" 
                                     Style="{StaticResource {x:Type ToggleButton}}" Padding="10,4" FontWeight="SemiBold" FontSize="11" Margin="0,0,4,0"/>
                        <RadioButton x:Name="RbFiltroSinCambio" Content="⏸️ Sin Cambios" Checked="FiltroRadio_Checked" 
                                     Style="{StaticResource {x:Type ToggleButton}}" Padding="10,4" FontWeight="SemiBold" FontSize="11"/>
                    </StackPanel>

                    <!-- Acciones Masivas -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnAutoAplicarDivisores" Content="✨ Auto-aplicar divisores sugeridos" Click="BtnAutoAplicarDivisores_Click"
                                Background="#EDE9FE" BorderBrush="#C4B5FD" BorderThickness="1" Foreground="#6D28D9" FontWeight="Bold" FontSize="11" Padding="10,4" Cursor="Hand" Margin="0,0,12,0"/>
                        <Button Content="☑️ Marcar con cambios" Click="BtnMarcarTodos_Click" Background="Transparent" BorderThickness="0" Foreground="#2563EB" FontWeight="Bold" FontSize="11" Cursor="Hand" Margin="0,0,10,0"/>
                        <Button Content="◻️ Desmarcar todos" Click="BtnDesmarcarTodos_Click" Background="Transparent" BorderThickness="0" Foreground="#64748B" FontWeight="Bold" FontSize="11" Cursor="Hand"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- Tabla Comparativa -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
            <Grid>
                <DataGrid x:Name="GridComparativa" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                          RowHeight="42" FontSize="12" Background="White" BorderThickness="0">
                    <DataGrid.Columns>
                        <!-- Aplicar -->
                        <DataGridCheckBoxColumn Header="Aplicar" Binding="{Binding Aplicar, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                        <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="75" FontWeight="SemiBold" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Cód. Prov." Binding="{Binding CodigoProveedor}" Width="85" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Código Barras" Binding="{Binding CodigoBarras}" Width="110" IsReadOnly="True"/>

                        <!-- Descripción con mayorista debajo si existe -->
                        <DataGridTemplateColumn Header="Descripción del Artículo" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="4,2">
                                        <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DescripcionProveedor, StringFormat='(Prov: {0})'}" 
                                                   FontSize="10.5" Foreground="#64748B" FontStyle="Italic" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding DescripcionProveedor, Converter={StaticResource BoolToVisConverter}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Precios Anteriores y del Proveedor -->
                        <DataGridTextColumn Header="Costo Actual" Binding="{Binding CostoAnterior, StringFormat='${0:N2}'}" Width="85" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Costo Lista" Binding="{Binding CostoOriginalProveedor, StringFormat='${0:N2}'}" Width="85" Foreground="#64748B" IsReadOnly="True"/>

                        <!-- Divisor de Bulto/Pack -->
                        <DataGridTemplateColumn Header="Divisor/Pack" Width="105">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBox Text="{Binding FactorConversion, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" 
                                                 Width="36" Padding="2" TextAlignment="Center" FontWeight="Bold" FontSize="11.5"
                                                 VerticalAlignment="Center"/>
                                        <Button Content="{Binding SugerenciaBotonTexto}" 
                                                Click="BtnAplicarFactorFila_Click" 
                                                ToolTip="Haga clic para aplicar el divisor detectado del pack mayorista"
                                                Visibility="{Binding MostrarBotonSugerido, Converter={StaticResource BoolToVisConverter}}"
                                                Background="#7C3AED" Foreground="White" FontWeight="Bold" FontSize="10" 
                                                Padding="4,2" Margin="4,0,0,0" Cursor="Hand" BorderThickness="0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Costo y Ventas Resultantes -->
                        <DataGridTextColumn Header="Costo Final" Binding="{Binding CostoNuevo, StringFormat='${0:N2}'}" Width="90" FontWeight="Bold" Foreground="#B91C1C" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Venta Actual" Binding="{Binding VentaAnterior, StringFormat='${0:N2}'}" Width="85" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Venta Nueva" Binding="{Binding VentaNueva, StringFormat='${0:N2}'}" Width="95" FontWeight="Black" Foreground="#0284C7" IsReadOnly="True"/>

                        <!-- % Variación y Badge de Alerta -->
                        <DataGridTemplateColumn Header="% Variación" Width="115">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Visibility="{Binding EsAlertaVariacionExtrema, Converter={StaticResource BoolToVisConverter}}"
                                                Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="4" Padding="5,2">
                                            <TextBlock Text="{Binding EstadoVariacionTexto}" FontWeight="Bold" Foreground="#DC2626" FontSize="11"/>
                                        </Border>
                                        <TextBlock Visibility="{Binding NoEsAlerta, Converter={StaticResource BoolToVisConverter}}"
                                                   Text="{Binding VariacionTexto}" FontWeight="Bold" Foreground="{Binding VariacionColorHex}" FontSize="11.5"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="TxtEstadoVacio" Text="Seleccione la lista de precios del proveedor y presione 'Comparar Precios' para cotejar variaciones y bultos."
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="#94A3B8" FontWeight="Medium"/>
            </Grid>
        </Border>

        <!-- Barra de Progreso -->
        <ProgressBar x:Name="PbProgreso" Grid.Row="4" Height="8" Margin="0,10,0,0" IsIndeterminate="True" Visibility="Collapsed"/>

        <!-- Pie y Botones -->
        <DockPanel Grid.Row="5" Margin="0,12,0,0">
            <Button Content="Cerrar" Click="BtnCerrar_Click" Padding="16,8" FontSize="12" Cursor="Hand"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="TxtMensajeResultado" VerticalAlignment="Center" FontSize="12.5" FontWeight="Bold" Margin="0,0,16,0"/>
                <Button x:Name="BtnAplicarAumento" Content="💾 Actualizar Precios Seleccionados" Click="BtnAplicarAumento_Click"
                        Background="#7C3AED" Foreground="White" FontWeight="Bold" Padding="20,8" FontSize="13" Cursor="Hand" IsEnabled="False"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
