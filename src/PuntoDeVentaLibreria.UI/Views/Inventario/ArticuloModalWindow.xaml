<Window x:Class="PuntoDeVentaLibreria.UI.Views.Inventario.ArticuloModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Ficha de Artículo / Útil" 
        Height="730" Width="860"
        MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F8FAFC"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Border Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="GESTIÓN DE ARTÍCULO &amp; ÚTILES" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Complete los datos comerciales, stock y acceso rápido" FontSize="12" Foreground="#64748B"/>
            </StackPanel>
        </Border>

        <!-- Formulario con Scroll -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Nombre y SKU -->
                <TextBlock Text="Nombre del Artículo / Libro / Servicio:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtNombre" Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8,6" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Código de Barras con botón de generación y soporte de lector -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <DockPanel LastChildFill="False" Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" Text="Código de Barras / EAN:" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Content="⚡ Auto-generar" Click="BtnGenerarCodigoBarras_Click"
                                    Background="#E0E7FF" Foreground="#3730A3" BorderThickness="0" Padding="6,2" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                        </DockPanel>
                        <TextBox x:Name="TxtCodigoBarras" Text="{Binding CodigoBarras, UpdateSourceTrigger=PropertyChanged}" 
                                 GotFocus="TxtCodigoBarras_GotFocus" KeyDown="TxtCodigoBarras_KeyDown"
                                 FontSize="14" Padding="8,6"/>
                        <TextBlock Text="💡 Código principal del producto (o pistolee con el lector físico)." FontSize="10.5" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Código SKU Único con botón de regeneración -->
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <DockPanel LastChildFill="False" Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" Text="Código SKU Único:" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Content="🔄 Nuevo SKU" Click="BtnGenerarSku_Click"
                                    Background="#F1F5F9" Foreground="#475569" BorderThickness="0" Padding="6,2" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                        </DockPanel>
                        <TextBox x:Name="TxtSKU" Text="{Binding SKU, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8,6"/>
                        <TextBlock Text="Identificador comercial único del producto o libro." FontSize="10.5" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Proveedor y Código de Proveedor -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Proveedor Asignado:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbProveedor" FontSize="13" Padding="8,6" DisplayMemberPath="Nombre" SelectedValuePath="Id"
                                  SelectionChanged="CmbProveedor_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Código en Catálogo Proveedor:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding CodigoProveedor, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Padding="8,6"/>
                    </StackPanel>
                </Grid>

                <!-- Rubro Comercial y Tipo de Artículo -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Rubro Comercial:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbRubro" FontSize="13" Padding="8,6" SelectionChanged="CmbRubro_SelectionChanged">
                            <ComboBoxItem Content="📚 Librería (Escolar / Comercial / Libros)" Tag="Librería" IsSelected="True"/>
                            <ComboBoxItem Content="🎁 Regalería (Bazar / Accesorios / Marroquinería)" Tag="Regalería"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Tipo de Artículo:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbTipo" FontSize="13" Padding="8,6" SelectionChanged="CmbTipo_SelectionChanged">
                            <ComboBoxItem Content="📦 Artículo Físico Estándar" Tag="Estandar" IsSelected="True"/>
                            <ComboBoxItem Content="🎒 Combo Escolar / Kit de Útiles" Tag="ComboKit"/>
                            <ComboBoxItem Content="🖨️ Servicio / Fotocopias / Impresión" Tag="Servicio"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Ubicación en Local -->
                <Grid Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Ubicación en Local / Estantería:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Ubicacion, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Padding="8,6"/>
                    </StackPanel>
                </Grid>

                <!-- SECCIÓN PACK / CAJA FRACCIONABLE -->
                <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <CheckBox x:Name="ChkEsPack" Content="📦 Es un Pack / Caja cerrada (descuenta unidades de un artículo base)"
                                  IsChecked="{Binding EsPack, Mode=TwoWay}" FontWeight="Bold" FontSize="12.5" Foreground="#1E293B"
                                  Checked="ChkEsPack_Checked" Unchecked="ChkEsPack_Unchecked"/>
                        <TextBlock Text="Al vender esta caja/pack, descuenta automáticamente las unidades del artículo base seleccionado."
                                   FontSize="11" Foreground="#64748B" Margin="24,2,0,8"/>

                        <Grid x:Name="PanelDetallePack" Visibility="Collapsed" Margin="24,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Artículo Base Suelto vinculado (*):" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbArticuloBase" DisplayMemberPath="Nombre" SelectedValuePath="Id"
                                          FontSize="12" Padding="6,4"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Unidades por Pack (*):" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtCantidadPorPack" Text="{Binding CantidadPorPack, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="13" FontWeight="Bold" HorizontalContentAlignment="Center" Padding="6,4"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- PANEL DE COMPONENTES DE COMBO / KIT ESCOLAR -->
                <Border x:Name="BrdComponentesCombo" Visibility="Collapsed"
                        Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1.5" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="🎒 COMPONENTES DEL COMBO ESCOLAR" FontWeight="Bold" FontSize="13" Foreground="#92400E" Margin="0,0,0,2"/>
                        <TextBlock Text="Al vender este combo, el sistema descontará automáticamente el stock de cada útil de la lista." FontSize="11" Foreground="#78350F" Margin="0,0,0,10"/>

                        <!-- Fila para agregar componente -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="CmbArticuloParaCombo" DisplayMemberPath="Nombre" SelectedValuePath="Id"
                                      FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>

                            <TextBox x:Name="TxtCantidadParaCombo" Grid.Column="1" Text="1" FontSize="12" FontWeight="Bold"
                                     HorizontalContentAlignment="Center" Margin="0,0,8,0" VerticalAlignment="Center" Padding="4"/>

                            <Button Grid.Column="2" Content="➕ Agregar" Click="BtnAgregarComponente_Click"
                                    Background="#D97706" Foreground="White" FontWeight="Bold" Padding="12,6" Cursor="Hand"/>
                        </Grid>

                        <!-- Grilla de Componentes -->
                        <DataGrid x:Name="GridComponentes" ItemsSource="{Binding ComponentesDelCombo}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" Height="140" FontSize="11.5">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Útil / Componente" Binding="{Binding NombreArticulo}" Width="*" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="90"/>
                                <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="60" FontWeight="Bold"/>
                                <DataGridTemplateColumn Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="❌" Click="BtnQuitarComponente_Click" Width="24" Height="24"
                                                    Background="Transparent" BorderThickness="0" Foreground="#DC2626" Cursor="Hand"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Precios y Margen Sugerido -->
                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left" Text="PRECIOS COMERCIALES Y MARGEN SUGERIDO" FontSize="11.5" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"/>
                            <Button x:Name="BtnAplicarMargenConfig" DockPanel.Dock="Right" Content="🎯 Aplicar Margen del Comercio (40%)" Click="BtnAplicarMargenConfig_Click"
                                    Background="#EFF6FF" Foreground="#2563EB" BorderBrush="#BFDBFE" BorderThickness="1" Padding="8,3" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                        </DockPanel>

                        <Grid Margin="0,0,0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="0.9*"/>
                                <ColumnDefinition Width="1.3*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Precio Costo ($):" FontSize="12" FontWeight="SemiBold" Margin="0,0,6,4"/>
                            <TextBox x:Name="TxtCosto" Grid.Row="1" Grid.Column="0" 
                                     TextChanged="TxtCosto_TextChanged"
                                     FontSize="14" FontWeight="Bold" Padding="8,6" Margin="0,0,6,0"/>

                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Alícuota IVA:" FontSize="12" FontWeight="SemiBold" Margin="6,0,6,4"/>
                            <ComboBox x:Name="CmbIva" Grid.Row="1" Grid.Column="1" FontSize="13" Padding="6,6" Margin="6,0,6,0"
                                      SelectionChanged="CmbIva_SelectionChanged">
                                <ComboBoxItem Content="21% (Útiles/Papelería)" Tag="21" IsSelected="True"/>
                                <ComboBoxItem Content="10.5% (Reducido)" Tag="10.5"/>
                                <ComboBoxItem Content="0% (Libros exentos)" Tag="0"/>
                            </ComboBox>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="% Margen:" FontSize="12" FontWeight="SemiBold" Margin="6,0,6,4"/>
                            <TextBox x:Name="TxtMargen" Grid.Row="1" Grid.Column="2" 
                                     TextChanged="TxtMargen_TextChanged"
                                     FontSize="14" FontWeight="Bold" Padding="8,6" Margin="6,0,6,0"/>

                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Precio Venta ($):" FontSize="12" FontWeight="SemiBold" Foreground="#0284C7" Margin="6,0,0,4"/>
                            <TextBox x:Name="TxtVenta" Grid.Row="1" Grid.Column="3" 
                                     TextChanged="TxtVenta_TextChanged"
                                     FontSize="16" FontWeight="Black" Foreground="#0369A1" Padding="8,6" Margin="6,0,0,0"/>

                            <!-- Botones de Redondeo Rápido a Centena -->
                            <StackPanel x:Name="PnlBotonesRedondeo" Grid.Row="2" Grid.Column="3" Orientation="Horizontal" Margin="6,4,0,0" Visibility="Collapsed">
                                <Button x:Name="BtnRedondearAbajo" Content="⬇️ $0" Click="BtnRedondearAbajo_Click"
                                        ToolTip="Redondear al $100 inferior más cercano (ajusta margen)"
                                        Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" 
                                        Foreground="#475569" FontSize="10.5" FontWeight="Bold" Padding="5,2" Margin="0,0,4,0" Cursor="Hand"/>
                                <Button x:Name="BtnRedondearArriba" Content="⬆️ $0" Click="BtnRedondearArriba_Click"
                                        ToolTip="Redondear al $100 superior más cercano (ajusta margen)"
                                        Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" 
                                        Foreground="#1D4ED8" FontSize="10.5" FontWeight="Bold" Padding="5,2" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="💡 Al ingresar Costo o IVA, el sistema calcula automáticamente el Precio de Venta según el margen. También puede tipear el Precio de Venta final y se actualizará el margen." 
                                   FontSize="10.5" Foreground="#64748B" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- SECCIÓN DE VARIANTES DE COLOR / MODELO -->
                <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <CheckBox x:Name="ChkTieneVariantes" 
                                      Content="🎨 Este artículo tiene variantes de color / modelo (con código de barras y stock independiente)"
                                      FontWeight="Bold" FontSize="12.5" Foreground="#1E293B" VerticalAlignment="Center"
                                      Checked="ChkTieneVariantes_Checked" Unchecked="ChkTieneVariantes_Unchecked"/>
                            <Border x:Name="BrdBadgeResumenVariantes" DockPanel.Dock="Right" Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="TxtResumenVariantes" Text="0 colores registrados" FontSize="11" FontWeight="Bold" Foreground="#4338CA"/>
                            </Border>
                        </DockPanel>
                        <TextBlock Text="Active esta opción si el producto viene en varios colores, diseños o modelos con distinto código de barras para controlar el stock exacto al reponer."
                                   FontSize="11" Foreground="#64748B" Margin="24,2,0,0" TextWrapping="Wrap"/>

                        <!-- PANEL DESPLEGABLE DE GESTIÓN DE VARIANTES -->
                        <Border x:Name="PanelVariantes" Visibility="Collapsed" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="AGREGAR NUEVO COLOR O MODELO:" FontSize="11.5" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,8"/>

                                <!-- Fila para agregar variante con amplio espacio -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.8*"/>
                                        <ColumnDefinition Width="2.2*"/>
                                        <ColumnDefinition Width="0.9*"/>
                                        <ColumnDefinition Width="0.9*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="Color / Variante (*):" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                        <TextBox x:Name="TxtColorVariante" KeyDown="TxtVariante_KeyDown" FontSize="13" Padding="8,5" ToolTip="Ej: Azul, Rojo, Verde, Pastel, etc."/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="6,0,6,0">
                                        <DockPanel LastChildFill="False" Margin="0,0,0,3">
                                            <TextBlock Text="Código de Barras:" FontSize="11" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                                            <Button DockPanel.Dock="Right" Content="⚡ Auto-generar" Click="BtnGenerarCodigoVariante_Click"
                                                    Background="#EFF6FF" Foreground="#2563EB" BorderThickness="0" FontSize="10.5" FontWeight="Bold" Padding="6,1" Cursor="Hand"/>
                                        </DockPanel>
                                        <TextBox x:Name="TxtCodigoBarrasVariante" KeyDown="TxtVariante_KeyDown" FontSize="12.5" FontFamily="Consolas, Segoe UI" Padding="8,5"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="6,0,6,0">
                                        <TextBlock Text="Stock Actual:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                        <TextBox x:Name="TxtStockVariante" Text="0" KeyDown="TxtVariante_KeyDown" FontSize="13" FontWeight="Bold" HorizontalContentAlignment="Center" Padding="8,5"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Margin="6,0,6,0">
                                        <TextBlock Text="Stock Mínimo:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                        <TextBox x:Name="TxtStockMinVariante" Text="0" KeyDown="TxtVariante_KeyDown" FontSize="13" HorizontalContentAlignment="Center" Padding="8,5"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4" Margin="6,0,0,0" VerticalAlignment="Bottom">
                                        <Button Content="➕ Añadir Color" Click="BtnAgregarVariante_Click"
                                                Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="12.5" Padding="14,7" Cursor="Hand"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Tabla de Variantes -->
                                <DataGrid x:Name="GridVariantes" ItemsSource="{Binding VariantesLista, RelativeSource={RelativeSource AncestorType=Window}}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" MaxHeight="180" FontSize="12.5"
                                          Background="White" BorderBrush="#E2E8F0" BorderThickness="1" RowHeight="34">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Color / Variante" Binding="{Binding Nombre}" Width="1.5*" FontWeight="SemiBold"/>
                                        <DataGridTextColumn Header="Código de Barras" Binding="{Binding CodigoBarras}" Width="2*" FontFamily="Consolas, Segoe UI"/>
                                        <DataGridTextColumn Header="Stock Actual" Binding="{Binding StockActual, StringFormat='N0'}" Width="100" FontWeight="Bold"/>
                                        <DataGridTextColumn Header="Stock Mín." Binding="{Binding StockMinimo, StringFormat='N0'}" Width="90"/>
                                        <DataGridTemplateColumn Width="45">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="🗑️" Click="BtnEliminarVariante_Click" Tag="{Binding}" Width="26" Height="26"
                                                            Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Quitar color"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Stock General / Único -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock x:Name="LblStockActual" Text="Stock Total / Único:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtStockActual" Text="{Binding StockActual, UpdateSourceTrigger=PropertyChanged, StringFormat='N0'}" FontSize="14" Padding="8,6"/>
                        <TextBlock x:Name="TxtStockVarianteAviso" Text="💡 Si cargó colores arriba, este total se calcula sumando todos los colores." FontSize="10.5" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Alerta Stock Mínimo General:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtStockMinimo" Text="{Binding StockMinimo, UpdateSourceTrigger=PropertyChanged, StringFormat='N0'}" FontSize="14" Padding="8,6"/>
                    </StackPanel>
                </Grid>

                <!-- Botón Rápido Mostrador -->
                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <CheckBox Content="Mostrar en la Botonera Rápida Táctil del Mostrador" 
                                  IsChecked="{Binding EsBotonRapido}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Color del Botón:" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="CmbColor" Width="140" SelectedValuePath="Tag" SelectedValue="{Binding ColorBoton}">
                                <ComboBoxItem Content="Azul" Tag="#3B82F6"/>
                                <ComboBoxItem Content="Verde" Tag="#10B981"/>
                                <ComboBoxItem Content="Púrpura" Tag="#8B5CF6"/>
                                <ComboBoxItem Content="Ámbar" Tag="#F59E0B"/>
                                <ComboBoxItem Content="Rojo" Tag="#EF4444"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Botones de Acción -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <Button Content="Cancelar" Click="BtnCancelar_Click" Padding="16,8" FontSize="13" Cursor="Hand" Margin="0,0,8,0"/>
            <Button x:Name="BtnEliminar" Content="🗑️ Eliminar Producto" Click="BtnEliminar_Click" Padding="14,8" FontSize="13" Cursor="Hand"
                    Background="#FEF2F2" Foreground="#DC2626" BorderBrush="#FECACA" FontWeight="SemiBold" Visibility="Collapsed"/>
            <Button Content="💾 Guardar Artículo" Click="BtnGuardar_Click" HorizontalAlignment="Right"
                    Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="20,8" FontSize="13" Cursor="Hand"/>
        </DockPanel>
    </Grid>
</Window>
