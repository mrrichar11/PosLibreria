<Window x:Class="PuntoDeVentaLibreria.UI.Views.Inventario.ArticuloModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Ficha de Artículo / Útil" 
        Height="620" Width="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Border Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="GESTIÓN DE ARTÍCULO &amp; ÚTILES" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Complete los datos comerciales, stock y acceso rápido" FontSize="12" Foreground="#64748B"/>
            </StackPanel>
        </Border>

        <!-- Formulario con Scroll -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Nombre y SKU -->
                <TextBlock Text="Nombre del Artículo / Libro / Servicio:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtNombre" Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8,6" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Código de Barras / ISBN / EAN:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding CodigoBarras, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8,6"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Código SKU / Clave Interna:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SKU, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8,6"/>
                    </StackPanel>
                </Grid>

                <!-- Ubicación -->
                <TextBlock Text="Ubicación en Local / Estantería / Góndola:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Ubicacion, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Padding="8,6" Margin="0,0,0,12"/>

                <!-- Precios -->
                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Precio Costo ($):" FontSize="12" FontWeight="SemiBold" Margin="0,0,6,4"/>
                        <TextBox x:Name="TxtCosto" Grid.Row="1" Grid.Column="0" Text="{Binding PrecioCosto, UpdateSourceTrigger=PropertyChanged, StringFormat='N2'}" FontSize="14" FontWeight="Bold" Padding="8,6" Margin="0,0,6,0"/>

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="% Margen:" FontSize="12" FontWeight="SemiBold" Margin="6,0,6,4"/>
                        <TextBox x:Name="TxtMargen" Grid.Row="1" Grid.Column="1" Text="{Binding PorcentajeGanancia, UpdateSourceTrigger=PropertyChanged, StringFormat='N1'}" FontSize="14" FontWeight="Bold" Padding="8,6" Margin="6,0,6,0"/>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Precio Venta ($):" FontSize="12" FontWeight="SemiBold" Foreground="#0284C7" Margin="6,0,0,4"/>
                        <TextBox x:Name="TxtVenta" Grid.Row="1" Grid.Column="2" Text="{Binding PrecioVenta, UpdateSourceTrigger=PropertyChanged, StringFormat='N2'}" FontSize="16" FontWeight="Black" Foreground="#0369A1" Padding="8,6" Margin="6,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Stock -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Stock Actual en Depósito/Mostrador:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding StockActual, UpdateSourceTrigger=PropertyChanged, StringFormat='N0'}" FontSize="14" Padding="8,6"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Alerta Stock Mínimo:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding StockMinimo, UpdateSourceTrigger=PropertyChanged, StringFormat='N0'}" FontSize="14" Padding="8,6"/>
                    </StackPanel>
                </Grid>

                <!-- Botón Rápido Mostrador -->
                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <CheckBox Content="Mostrar en la Botonera Rápida Táctil del Mostrador" 
                                  IsChecked="{Binding EsBotonRapido}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Color del Botón:" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="CmbColor" Width="140" SelectedValuePath="Tag" SelectedValue="{Binding ColorBoton}">
                                <ComboBoxItem Content="Azul" Tag="#3B82F6"/>
                                <ComboBoxItem Content="Verde" Tag="#10B981"/>
                                <ComboBoxItem Content="Púrpura" Tag="#8B5CF6"/>
                                <ComboBoxItem Content="Ámbar" Tag="#F59E0B"/>
                                <ComboBoxItem Content="Rojo" Tag="#EF4444"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Botones de Acción -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <Button Content="Cancelar" Click="BtnCancelar_Click" Padding="16,8" FontSize="13" Cursor="Hand"/>
            <Button Content="💾 Guardar Artículo" Click="BtnGuardar_Click" HorizontalAlignment="Right"
                    Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="20,8" FontSize="13" Cursor="Hand"/>
        </DockPanel>
    </Grid>
</Window>
