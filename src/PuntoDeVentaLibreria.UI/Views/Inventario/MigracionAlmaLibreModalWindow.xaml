<Window x:Class="PuntoDeVentaLibreria.UI.Views.Inventario.MigracionAlmaLibreModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Migración &amp; Carga de Catálogo (Alma Libre / Sistema Anterior)" 
        Height="700" Width="1000"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Border Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="MIGRACIÓN RÁPIDA DE CATÁLOGO DESDE EXCEL" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Importe los miles de artículos del sistema anterior (Alma Libre / Sixtored) conservando SKUs, códigos de barras, rubros, costos y precios." FontSize="12" Foreground="#64748B"/>
            </StackPanel>
        </Border>

        <!-- Selector de Archivo y Opciones -->
        <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Ruta de archivo -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Archivo Excel a importar (.xlsx o .xls):" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="📁 Examinar..." Click="BtnExaminar_Click"
                                Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Padding="12,6" FontWeight="SemiBold" Cursor="Hand" Margin="6,0,0,0"/>
                        <TextBox x:Name="TxtRutaArchivo" IsReadOnly="True" FontSize="12.5" Padding="8,6" Background="#F8FAFC"/>
                    </DockPanel>
                </StackPanel>

                <!-- Proveedor por defecto -->
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Asignar a Proveedor (Opcional):" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbProveedor" DisplayMemberPath="Nombre" SelectedValuePath="Id" FontSize="12.5" Padding="8,6"/>
                </StackPanel>

                <!-- Botón Previsualizar -->
                <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Bottom">
                    <Button x:Name="BtnAnalizar" Content="🔎 Analizar Archivo" Click="BtnAnalizar_Click"
                            Background="#0284C7" Foreground="White" FontWeight="Bold" Padding="16,8" Cursor="Hand"/>
                </StackPanel>

                <!-- Métricas del archivo analizado -->
                <StackPanel x:Name="PnlMetricas" Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtTotalFilas" Text="Total Filas: 0" FontWeight="Bold" Foreground="#166534" FontSize="12"/>
                    </Border>
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtNuevos" Text="Artículos Nuevos: 0" FontWeight="Bold" Foreground="#1E40AF" FontSize="12"/>
                    </Border>
                    <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="10,4">
                        <TextBlock x:Name="TxtActualizables" Text="Coincidentes a Actualizar: 0" FontWeight="Bold" Foreground="#92400E" FontSize="12"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabla de Previsualización -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
            <Grid>
                <DataGrid x:Name="GridPreview" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                          RowHeight="36" FontSize="12" Background="White" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SKU / Código" Binding="{Binding SKU}" Width="100" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Cód. Prov." Binding="{Binding CodigoProveedor}" Width="90"/>
                        <DataGridTextColumn Header="Código de Barras" Binding="{Binding CodigoBarras}" Width="130"/>
                        <DataGridTextColumn Header="Descripción del Artículo" Binding="{Binding Nombre}" Width="*"/>
                        <DataGridTextColumn Header="Rubro / Categoría" Binding="{Binding CategoriaRubro}" Width="120"/>
                        <DataGridTextColumn Header="P. Costo" Binding="{Binding PrecioCosto, StringFormat='${0:N2}'}" Width="85"/>
                        <DataGridTextColumn Header="IVA %" Binding="{Binding IvaPorcentaje, StringFormat='{}{0}%'}" Width="65"/>
                        <DataGridTextColumn Header="Margen %" Binding="{Binding PorcentajeGanancia, StringFormat='{}{0}%'}" Width="75"/>
                        <DataGridTextColumn Header="P. Venta" Binding="{Binding PrecioVenta, StringFormat='${0:N2}'}" Width="95" FontWeight="Bold"/>
                        <DataGridTemplateColumn Header="Estado" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding YaExisteEnSistema, Converter={x:Null}}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="NUEVO"/>
                                                <Setter Property="Foreground" Value="#16A34A"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding YaExisteEnSistema}" Value="True">
                                                        <Setter Property="Text" Value="EXISTENTE"/>
                                                        <Setter Property="Foreground" Value="#D97706"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="TxtEstadoVacio" Text="Seleccione el archivo 'Lista de precios ALMA LIBRE.xlsx' y presione 'Analizar Archivo' para ver la vista previa."
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="#94A3B8" FontWeight="Medium"/>
            </Grid>
        </Border>

        <!-- Barra de Progreso -->
        <ProgressBar x:Name="PbProgreso" Grid.Row="3" Height="8" Margin="0,10,0,0" IsIndeterminate="True" Visibility="Collapsed"/>

        <!-- Pie y Botones de Acción -->
        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <Button Content="Cerrar" Click="BtnCerrar_Click" Padding="16,8" FontSize="12" Cursor="Hand"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="TxtMensajeResultado" VerticalAlignment="Center" FontSize="12.5" FontWeight="Bold" Margin="0,0,16,0"/>
                <Button x:Name="BtnImportar" Content="🚀 Comenzar Importación al Sistema" Click="BtnImportar_Click"
                        Background="#16A34A" Foreground="White" FontWeight="Bold" Padding="20,8" FontSize="13" Cursor="Hand" IsEnabled="False"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
