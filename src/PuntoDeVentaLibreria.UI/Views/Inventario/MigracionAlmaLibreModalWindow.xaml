<Window x:Class="PuntoDeVentaLibreria.UI.Views.Inventario.MigracionAlmaLibreModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Migración &amp; Carga de Catálogo (Alma Libre / Sistema Anterior)" 
        Height="800" Width="1240"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Border Grid.Row="0" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="MIGRACIÓN RÁPIDA DE CATÁLOGO DESDE EXCEL" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Importe los miles de artículos del sistema anterior conservando SKUs, códigos de barras, rubros, costos, precios, controlando stock inicial y detectando artículos del Mayorista El Once." FontSize="12" Foreground="#64748B"/>
            </StackPanel>
        </Border>

        <!-- Selector de Archivo y Proveedor -->
        <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Ruta de archivo -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Archivo Excel a importar (.xlsx o .xls):" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="📁 Examinar..." Click="BtnExaminar_Click"
                                Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Padding="12,6" FontWeight="SemiBold" Cursor="Hand" Margin="6,0,0,0"/>
                        <TextBox x:Name="TxtRutaArchivo" IsReadOnly="True" FontSize="12" Padding="8,6" Background="#F8FAFC"/>
                    </DockPanel>
                </StackPanel>

                <!-- Proveedor por defecto -->
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Asignar a Proveedor (Opcional):" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbProveedor" DisplayMemberPath="Nombre" SelectedValuePath="Id" FontSize="12" Padding="8,5"/>
                </StackPanel>

                <!-- Botón Analizar -->
                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                    <Button x:Name="BtnAnalizar" Content="🔎 Analizar Archivo" Click="BtnAnalizar_Click"
                            Background="#0284C7" Foreground="White" FontWeight="Bold" Padding="18,8" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Barra de Filtros y Herramientas de Depuración -->
        <Border Grid.Row="2" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Buscador de texto -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="🔍 Buscar en catálogo:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtFiltroTexto" Padding="6,4" FontSize="12" TextChanged="Filtros_Changed" ToolTip="Buscar por Nombre, SKU, Código de Proveedor o Código de Barras"/>
                    </StackPanel>

                    <!-- Filtro por Fecha de Carga (fchalta) -->
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="📅 Fecha de Carga (Desde):" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                        <DatePicker x:Name="DpFechaAltaDesde" SelectedDateChanged="Filtros_Changed" FontSize="11.5"/>
                    </StackPanel>

                    <!-- Filtro por Última Actualización de Precio (fchultpre) -->
                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="📅 Últ. Actualización Precio (Desde):" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                        <DatePicker x:Name="DpFechaPrecioDesde" SelectedDateChanged="Filtros_Changed" FontSize="11.5"/>
                    </StackPanel>

                    <!-- Filtro de Proveedor / Cruce Once -->
                    <StackPanel Grid.Column="3" Margin="0,0,10,0">
                        <TextBlock Text="🏷️ Origen / Proveedor:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CmbFiltroProveedor" SelectionChanged="Filtros_Changed" FontSize="11.5" Padding="6,4">
                            <ComboBoxItem Content="Todos los artículos" IsSelected="True"/>
                            <ComboBoxItem Content="🏷️ Solo Mayorista El Once"/>
                            <ComboBoxItem Content="Otros artículos"/>
                            <ComboBoxItem Content="Solo Nuevos (No importados)"/>
                            <ComboBoxItem Content="Solo Ya Importados"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Botón Limpiar Filtros -->
                    <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                        <Button Content="Limpiar Filtros" Click="BtnLimpiarFiltros_Click" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10,5" FontSize="11.5" Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <!-- Barra de Acciones Masivas y Métricas -->
                <DockPanel Margin="0,10,0,0">
                    <!-- Botones de Selección Rápida y Stock Masivo -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Button Content="☑️ Seleccionar Todos" Click="BtnSeleccionarTodos_Click" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Padding="8,4" FontSize="11" FontWeight="SemiBold" Margin="0,0,6,0" Cursor="Hand"/>
                        <Button Content="⬜ Deseleccionar Todos" Click="BtnDeseleccionarTodos_Click" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Padding="8,4" FontSize="11" FontWeight="SemiBold" Margin="0,0,12,0" Cursor="Hand"/>

                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚡ Stock masivo a seleccionados:" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#475569"/>
                                <TextBox x:Name="TxtStockMasivo" Text="1" Width="40" Padding="3,1" FontSize="11" TextAlignment="Center" Margin="0,0,6,0"/>
                                <Button Content="Aplicar" Click="BtnAplicarStockMasivo_Click" Background="#0284C7" Foreground="White" FontWeight="Bold" Padding="8,2" FontSize="11" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Badges Métricas Resumen -->
                    <StackPanel x:Name="PnlMetricas" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                            <TextBlock x:Name="TxtTotalFilas" Text="Filtrados: 0 / 0" FontWeight="Bold" Foreground="#166534" FontSize="11.5"/>
                        </Border>
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                            <TextBlock x:Name="TxtOnceCount" Text="🏷️ El Once: 0" FontWeight="Bold" Foreground="#1D4ED8" FontSize="11.5"/>
                        </Border>
                        <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="8,3">
                            <TextBlock x:Name="TxtSeleccionadosCount" Text="Seleccionados: 0" FontWeight="Bold" Foreground="#92400E" FontSize="11.5"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Tabla de Previsualización y Edición de Stock -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
            <Grid>
                <DataGrid x:Name="GridPreview" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                          RowHeight="34" FontSize="11.5" Background="White" BorderThickness="0"
                          VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <!-- Checkbox de Selección -->
                        <DataGridTemplateColumn Width="45">
                            <DataGridTemplateColumn.Header>
                                <CheckBox x:Name="ChkSeleccionarTodoHeader" Click="ChkSeleccionarTodoHeader_Click" HorizontalAlignment="Center" ToolTip="Seleccionar / Deseleccionar visibles"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Seleccionado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                              Checked="ChkItem_Checked" Unchecked="ChkItem_Unchecked" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="SKU / Cód." Binding="{Binding SKU}" Width="85" FontWeight="SemiBold" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Cód. Prov." Binding="{Binding CodigoProveedor}" Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Código de Barras" Binding="{Binding CodigoBarras}" Width="115" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Descripción del Artículo" Binding="{Binding Nombre}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Rubro" Binding="{Binding CategoriaRubro}" Width="100" IsReadOnly="True"/>
                        
                        <!-- Cruce Mayorista El Once -->
                        <DataGridTemplateColumn Header="Proveedor" Width="100" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Visibility="{Binding EsDeMayoristaElOnce, Converter={x:Null}}" 
                                                Background="#DBEAFE" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="4" Padding="5,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EsDeMayoristaElOnce}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="🏷️ EL ONCE" Foreground="#1E40AF" FontWeight="Bold" FontSize="10"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="P. Costo" Binding="{Binding PrecioCosto, StringFormat='${0:N2}'}" Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="P. Venta" Binding="{Binding PrecioVenta, StringFormat='${0:N2}'}" Width="85" FontWeight="Bold" IsReadOnly="True"/>
                        
                        <!-- Precio Tarjeta y Recargo -->
                        <DataGridTemplateColumn Header="P. Tarjeta (Recargo)" Width="120" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PrecioTarjeta, StringFormat='${0:N2}', TargetNullValue='-'}" FontWeight="SemiBold" Foreground="#0F172A"/>
                                        <TextBlock Text="{Binding RecargoTarjetaPorcentaje, StringFormat=' (+{0:N1}%)', TargetNullValue=''}" FontSize="10" Foreground="#D97706" FontWeight="Bold" Margin="3,0,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Fechas -->
                        <DataGridTextColumn Header="F. Carga" Binding="{Binding FechaAlta, StringFormat='dd/MM/yy', TargetNullValue='-'}" Width="75" IsReadOnly="True"/>
                        <DataGridTextColumn Header="F. Últ. Precio" Binding="{Binding FechaUltimaActualizacionPrecio, StringFormat='dd/MM/yy', TargetNullValue='-'}" Width="85" IsReadOnly="True"/>

                        <!-- Stock Inicial Editable -->
                        <DataGridTemplateColumn Header="📦 Stock Inicial" Width="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding StockImportar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:G29}'}" 
                                             Width="65" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                             FontWeight="Bold" Padding="3,2" Background="#FEFCE8" BorderBrush="#FDE047" BorderThickness="1"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Estado en Sistema -->
                        <DataGridTemplateColumn Header="Estado" Width="90" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock FontWeight="Bold" FontSize="10.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="NUEVO"/>
                                                <Setter Property="Foreground" Value="#16A34A"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding YaExisteEnSistema}" Value="True">
                                                        <Setter Property="Text" Value="EXISTENTE"/>
                                                        <Setter Property="Foreground" Value="#D97706"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="TxtEstadoVacio" Text="Seleccione el archivo 'Lista de precios ALMA LIBRE.xlsx' y presione 'Analizar Archivo' para ver la vista previa."
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="#94A3B8" FontWeight="Medium"/>
            </Grid>
        </Border>

        <!-- Barra de Progreso -->
        <ProgressBar x:Name="PbProgreso" Grid.Row="4" Height="8" Margin="0,10,0,0" IsIndeterminate="True" Visibility="Collapsed"/>

        <!-- Pie y Botones de Acción -->
        <DockPanel Grid.Row="5" Margin="0,12,0,0">
            <Button Content="Cerrar" Click="BtnCerrar_Click" Padding="16,8" FontSize="12" Cursor="Hand"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="TxtMensajeResultado" VerticalAlignment="Center" FontSize="12.5" FontWeight="Bold" Margin="0,0,16,0"/>
                <Button x:Name="BtnImportar" Content="🚀 Comenzar Importación Seleccionados" Click="BtnImportar_Click"
                        Background="#16A34A" Foreground="White" FontWeight="Bold" Padding="20,8" FontSize="13" Cursor="Hand" IsEnabled="False"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
