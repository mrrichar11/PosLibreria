<Window x:Class="PuntoDeVentaLibreria.UI.Views.Inventario.MigracionAlmaLibreModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:PuntoDeVentaLibreria.UI.Converters"
        mc:Ignorable="d"
        Title="Importador Universal de Catálogo &amp; Precios desde Excel" 
        Height="700" Width="1200"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Border Grid.Row="0" Margin="0,0,0,10">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="📥 Descargar Plantilla Excel Modelo" Click="BtnDescargarPlantilla_Click"
                        Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1.5" Foreground="#166534" FontWeight="Bold" Padding="14,8" FontSize="12" Cursor="Hand"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="IMPORTADOR UNIVERSAL DE CATÁLOGO &amp; EXCEL" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Importe productos de cualquier sistema anterior o proveedor con mapeo inteligente, control de stock y cálculo de precios." FontSize="12" Foreground="#64748B"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Selector de Archivo y Proveedor -->
        <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Ruta de archivo -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Archivo Excel / Planilla a importar (.xlsx, .xls, .csv):" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="📁 Examinar..." Click="BtnExaminar_Click"
                                Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Padding="12,6" FontWeight="SemiBold" Cursor="Hand" Margin="6,0,0,0"/>
                        <TextBox x:Name="TxtRutaArchivo" IsReadOnly="True" FontSize="12" Padding="8,6" Background="#F8FAFC"/>
                    </DockPanel>
                </StackPanel>

                <!-- Proveedor por defecto -->
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Asignar a Proveedor (Opcional):" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbProveedor" DisplayMemberPath="Nombre" SelectedValuePath="Id" FontSize="12" Padding="8,5"/>
                </StackPanel>

                <!-- Botón Analizar -->
                <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Orientation="Horizontal">
                    <Button x:Name="BtnAnalizar" Content="🔎 Analizar Archivo" Click="BtnAnalizar_Click"
                            Background="#0284C7" Foreground="White" FontWeight="Bold" Padding="18,8" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- PANEL DE MAPEO INTELIGENTE DE COLUMNAS (Desplegable) -->
        <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
            <Expander x:Name="ExpMapeo" Header="⚙️ Mapeo Inteligente de Columnas del Excel (Auto-Detectado)" IsExpanded="False" FontWeight="Bold" FontSize="12" Foreground="#1E293B">
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="El sistema detecta automáticamente las columnas, pero puede ajustar manualmente la correspondencia si su Excel tiene títulos diferentes:" 
                               FontSize="11" Foreground="#64748B" FontWeight="Normal" Margin="0,0,0,10"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Fila 1 -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="Código de Barras:" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                            <ComboBox x:Name="CmbColCodigoBarras" FontSize="11" Padding="6,3"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,8">
                            <TextBlock Text="Código Interno / SKU:" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                            <ComboBox x:Name="CmbColSku" FontSize="11" Padding="6,3"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,8,8">
                            <TextBlock Text="Descripción / Nombre:" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                            <ComboBox x:Name="CmbColDescripcion" FontSize="11" Padding="6,3"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,0,8">
                            <TextBlock Text="Precio de Venta (Efectivo):" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                            <ComboBox x:Name="CmbColPrecioVenta" FontSize="11" Padding="6,3"/>
                        </StackPanel>

                        <!-- Fila 2 -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="Precio de Costo:" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                            <ComboBox x:Name="CmbColPrecioCosto" FontSize="11" Padding="6,3"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,8">
                            <TextBlock Text="Precio Tarjeta (Opcional):" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                            <ComboBox x:Name="CmbColPrecioTarjeta" FontSize="11" Padding="6,3"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,8,8">
                            <TextBlock Text="Stock Actual / Cantidad:" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                            <ComboBox x:Name="CmbColStock" FontSize="11" Padding="6,3"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,0,8">
                            <TextBlock Text="Categoría / Rubro:" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                            <ComboBox x:Name="CmbColCategoria" FontSize="11" Padding="6,3"/>
                        </StackPanel>

                        <!-- Fila 3 -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Marca:" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                            <ComboBox x:Name="CmbColMarca" FontSize="11" Padding="6,3"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Código Proveedor:" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                            <ComboBox x:Name="CmbColCodProv" FontSize="11" Padding="6,3"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Text="Fecha Carga / Alta:" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                            <ComboBox x:Name="CmbColFechaAlta" FontSize="11" Padding="6,3"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="3" VerticalAlignment="Bottom">
                            <Button Content="🔄 Re-Analizar con este Mapeo" Click="BtnReanalizarConMapeo_Click"
                                    Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="10,5" FontSize="11" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Expander>
        </Border>

        <!-- Barra de Filtros y Herramientas -->
        <Border Grid.Row="3" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Buscador de texto -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="🔍 Buscar en catálogo:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtFiltroTexto" Padding="6,4" FontSize="12" TextChanged="Filtros_Changed" ToolTip="Buscar por Nombre, SKU, Código de Proveedor o Código de Barras"/>
                    </StackPanel>

                    <!-- Filtro por Fecha de Carga -->
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="📅 Fecha Carga (Desde):" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                        <DatePicker x:Name="DpFechaAltaDesde" SelectedDateChanged="Filtros_Changed" FontSize="11.5"/>
                    </StackPanel>

                    <!-- Filtro por Última Actualización de Precio -->
                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="📅 Últ. Actualización Precio:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                        <DatePicker x:Name="DpFechaPrecioDesde" SelectedDateChanged="Filtros_Changed" FontSize="11.5"/>
                    </StackPanel>

                    <!-- Filtro por Estado / Códigos -->
                    <StackPanel Grid.Column="3" Margin="0,0,10,0">
                        <TextBlock Text="🏷️ Filtro por Estado / Código:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CmbFiltroProveedor" SelectionChanged="Filtros_Changed" FontSize="11.5" Padding="6,4">
                            <ComboBoxItem Content="Todos los artículos" IsSelected="True"/>
                            <ComboBoxItem Content="✨ Solo Nuevos (No en sistema)"/>
                            <ComboBoxItem Content="🔄 Solo Existentes (A actualizar)"/>
                            <ComboBoxItem Content="📊 Con Código de Barras"/>
                            <ComboBoxItem Content="⚠️ Sin Código de Barras"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Botón Limpiar Filtros -->
                    <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                        <Button Content="Limpiar Filtros" Click="BtnLimpiarFiltros_Click" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Padding="10,5" FontSize="11.5" Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <!-- Barra de Acciones Masivas y Métricas -->
                <DockPanel Margin="0,10,0,0">
                    <!-- Botones de Selección Rápida y Stock Masivo -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Button Content="☑️ Seleccionar Todos" Click="BtnSeleccionarTodos_Click" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Padding="8,4" FontSize="11" FontWeight="SemiBold" Margin="0,0,6,0" Cursor="Hand"/>
                        <Button Content="⬜ Deseleccionar Todos" Click="BtnDeseleccionarTodos_Click" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Padding="8,4" FontSize="11" FontWeight="SemiBold" Margin="0,0,12,0" Cursor="Hand"/>

                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚡ Stock masivo a seleccionados:" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#475569"/>
                                <TextBox x:Name="TxtStockMasivo" Text="1" Width="40" Padding="3,1" FontSize="11" TextAlignment="Center" Margin="0,0,6,0"/>
                                <Button Content="Aplicar" Click="BtnAplicarStockMasivo_Click" Background="#0284C7" Foreground="White" FontWeight="Bold" Padding="8,2" FontSize="11" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Badges Métricas Resumen -->
                    <StackPanel x:Name="PnlMetricas" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                            <TextBlock x:Name="TxtTotalFilas" Text="Filtrados: 0 / 0" FontWeight="Bold" Foreground="#166534" FontSize="11.5"/>
                        </Border>
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                            <TextBlock x:Name="TxtNuevosCount" Text="✨ Nuevos: 0" FontWeight="Bold" Foreground="#1D4ED8" FontSize="11.5"/>
                        </Border>
                        <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="8,3">
                            <TextBlock x:Name="TxtSeleccionadosCount" Text="Seleccionados: 0" FontWeight="Bold" Foreground="#92400E" FontSize="11.5"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Grilla Principal con Scroll y Edición de Stock -->
        <Border Grid.Row="4" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
            <Grid>
                <DataGrid x:Name="DgPrevisualizacion" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          CanUserDeleteRows="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          RowHeight="34"
                          FontSize="11.5"
                          BorderThickness="0"
                          Background="Transparent">
                    <DataGrid.Columns>
                        <!-- Checkbox Selección -->
                        <DataGridCheckBoxColumn Binding="{Binding Seleccionado, UpdateSourceTrigger=PropertyChanged}" Width="40">
                            <DataGridCheckBoxColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGridCheckBoxColumn.HeaderStyle>
                        </DataGridCheckBoxColumn>

                        <!-- SKU / Código Interno -->
                        <DataGridTextColumn Header="Código / SKU" Binding="{Binding SKU}" Width="100" IsReadOnly="True"/>

                        <!-- Código Proveedor -->
                        <DataGridTextColumn Header="Cód. Prov." Binding="{Binding CodigoProveedor}" Width="85" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#64748B"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Código de Barras -->
                        <DataGridTextColumn Header="Código Barras" Binding="{Binding CodigoBarras}" Width="120" IsReadOnly="True"/>

                        <!-- Descripción / Nombre del Producto -->
                        <DataGridTextColumn Header="Descripción del Producto" Binding="{Binding Nombre}" Width="*" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Rubro / Categoría -->
                        <DataGridTextColumn Header="Rubro / Cat." Binding="{Binding CategoriaRubro}" Width="100" IsReadOnly="True"/>

                        <!-- Costo -->
                        <DataGridTextColumn Header="Costo" Binding="{Binding PrecioCosto, StringFormat='${0:N2}'}" Width="80" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#475569"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Margen % -->
                        <DataGridTextColumn Header="Margen" Binding="{Binding PorcentajeGanancia, StringFormat='{}{0:N0}%'}" Width="65" IsReadOnly="True"/>

                        <!-- Precio Venta Efectivo -->
                        <DataGridTextColumn Header="P. Efectivo" Binding="{Binding PrecioVenta, StringFormat='${0:N2}'}" Width="95" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#16A34A"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Precio Tarjeta -->
                        <DataGridTemplateColumn Header="P. Tarjeta" Width="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PrecioTarjeta, StringFormat='${0:N2}', TargetNullValue='-'}" FontWeight="SemiBold" Foreground="#2563EB"/>
                                        <TextBlock Text="{Binding RecargoTarjetaPorcentaje, StringFormat=' (+{0:N0}%)'}" FontSize="10" Foreground="#64748B"
                                                   Visibility="{Binding TieneRecargoTarjeta, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Stock a Importar (Editable inline) -->
                        <DataGridTemplateColumn Header="📦 Stock Inicial" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding StockImportar, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N0}'}" 
                                             FontWeight="Bold" TextAlignment="Center" Padding="4,2" Background="#FEF3C7" BorderBrush="#FCD34D"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Fechas -->
                        <DataGridTextColumn Header="F. Carga" Binding="{Binding FechaAlta, StringFormat='dd/MM/yy'}" Width="75" IsReadOnly="True"/>
                        <DataGridTextColumn Header="F. Precio" Binding="{Binding FechaUltimaActualizacionPrecio, StringFormat='dd/MM/yy'}" Width="75" IsReadOnly="True"/>

                        <!-- Estado en Catálogo -->
                        <DataGridTemplateColumn Header="Estado" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#F1F5F9" CornerRadius="4" Padding="4,1"
                                                Visibility="{Binding EsYaImportado, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="🔄 Existente" FontSize="10" FontWeight="SemiBold" Foreground="#475569"/>
                                        </Border>
                                        <Border Background="#F0FDF4" CornerRadius="4" Padding="4,1"
                                                Visibility="{Binding EsYaImportado, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                            <TextBlock Text="✨ Nuevo" FontSize="10" FontWeight="Bold" Foreground="#16A34A"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="TxtEstadoVacio" Text="Cargue un archivo Excel y haga clic en 'Analizar Archivo' para comenzar la importación." 
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="13"/>
            </Grid>
        </Border>

        <!-- Barra de Progreso -->
        <ProgressBar x:Name="PbProgreso" Grid.Row="5" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="0,6,0,0"/>

        <!-- Pie de Página y Acciones -->
        <Border Grid.Row="6" Margin="0,10,0,0">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="ℹ️ Consejo: Puede ajustar las cantidades de stock directamente en la grilla antes de importar." FontSize="11.5" Foreground="#64748B"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Click="BtnCancelar_Click" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Padding="16,8" FontWeight="SemiBold" Margin="0,0,10,0" Cursor="Hand"/>
                    <Button x:Name="BtnImportar" Content="🚀 Importar Artículos Seleccionados al Inventario" Click="BtnImportar_Click"
                            Background="#16A34A" Foreground="White" FontWeight="Bold" Padding="20,10" FontSize="13" Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
