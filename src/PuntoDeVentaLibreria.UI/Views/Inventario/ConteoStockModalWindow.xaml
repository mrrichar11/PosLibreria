<Window x:Class="PuntoDeVentaLibreria.UI.Views.Inventario.ConteoStockModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📋 Auditoría de Inventario y Conteo de Stock por Góndola"
        Height="720" Width="950"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Cabecera y Métricas de Progreso -->
            <RowDefinition Height="Auto"/> <!-- 1: Barra de Escáner y Modos -->
            <RowDefinition Height="Auto"/> <!-- 2: Ficha del Artículo Seleccionado -->
            <RowDefinition Height="*"/>    <!-- 3: Historial de Conteo de la Sesión -->
            <RowDefinition Height="Auto"/> <!-- 4: Pie de Página -->
        </Grid.RowDefinitions>

        <!-- 0: Cabecera y Barra de Progreso en Vivo -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <!-- Total -->
                        <Border Background="#F1F5F9" CornerRadius="8" Padding="10,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Total Catálogo: " FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="TxtTotalArticulos" Text="---" FontWeight="Bold" FontSize="12" Foreground="#0F172A"/>
                            </StackPanel>
                        </Border>

                        <!-- Contados -->
                        <Border Background="#DCFCE7" CornerRadius="8" Padding="10,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Auditados: " FontSize="11" Foreground="#166534"/>
                                <TextBlock x:Name="TxtAuditados" Text="---" FontWeight="Bold" FontSize="12" Foreground="#15803D"/>
                            </StackPanel>
                        </Border>

                        <!-- Pendientes -->
                        <Border Background="#FEF3C7" CornerRadius="8" Padding="10,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Pendientes: " FontSize="11" Foreground="#92400E"/>
                                <TextBlock x:Name="TxtPendientes" Text="---" FontWeight="Bold" FontSize="12" Foreground="#B45309"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AUDITORÍA DE INVENTARIO &amp; TOMA DE STOCK POR GÓNDOLA" FontSize="15" FontWeight="Black" Foreground="#0F172A"/>
                        <TextBlock Text="Actualice existencias producto por producto de forma continua o en ratos libres." FontSize="11.5" Foreground="#64748B"/>
                    </StackPanel>
                </DockPanel>

                <!-- Barra de Progreso -->
                <Grid Grid.Row="1">
                    <ProgressBar x:Name="PbProgreso" Height="14" Value="0" Maximum="100"
                                 Background="#E2E8F0" Foreground="#10B981" BorderThickness="0"/>
                    <TextBlock x:Name="TxtPorcentajeProgreso" Text="0% completado" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="10" FontWeight="Bold" Foreground="#1E293B"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 1: Barra de Escáner y Selección de Modo -->
        <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="📷" FontSize="20" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="PISTOLEO / BÚSQUEDA:" FontSize="12" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBox x:Name="TxtEscaneo" Grid.Column="1" FontSize="15" FontWeight="SemiBold" Padding="8,5"
                             BorderThickness="1" BorderBrush="#94A3B8" KeyDown="TxtEscaneo_KeyDown"/>

                    <Button Grid.Column="2" Content="Buscar [Enter]" Click="BtnBuscar_Click"
                            Margin="8,0,0,0" Padding="14,6" FontWeight="Bold" Cursor="Hand"
                            Background="#2563EB" Foreground="White"/>
                </Grid>

                <!-- Modos de Conteo -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Modo de auditoría: " FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <RadioButton x:Name="RbModoManual" Content="Ingresar cantidad física y confirmar [Recomendado]" IsChecked="True"
                                 FontWeight="Bold" FontSize="11.5" Foreground="#0F172A" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <RadioButton x:Name="RbModoContinuo" Content="Pistoleo rápido continuo (+1 por cada escaneo)"
                                 FontWeight="Bold" FontSize="11.5" Foreground="#2563EB" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2: Ficha del Artículo Seleccionado para Auditoría -->
        <Border x:Name="BrdFichaArticulo" Grid.Row="2" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="10" Padding="14" Margin="0,0,0,12" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Datos del Artículo -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtArticuloNombre" Text="Nombre del Artículo" FontSize="16" FontWeight="Black" Foreground="#0F172A" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border x:Name="BadgeRubro" Background="#E0E7FF" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock x:Name="TxtArticuloRubro" Text="Librería" FontSize="11" FontWeight="Bold" Foreground="#3730A3"/>
                        </Border>
                        <TextBlock x:Name="TxtArticuloCodigos" Text="SKU: ART-001 | Barras: 7791234567890" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtArticuloPrecio" Text="Precio Venta: $0,00" FontSize="12" FontWeight="SemiBold" Foreground="#15803D"/>
                </StackPanel>

                <!-- Ajuste de Stock -->
                <Border Grid.Column="1" Background="White" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="8" Padding="14,10" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Stock Actual en Sistema -->
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="Stock en Sistema:" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtStockSistema" Text="0" FontSize="18" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="➔" FontSize="20" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,16,0"/>

                        <!-- Nuevo Stock Físico Contado -->
                        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="Stock Real Contado (*):" FontSize="11" FontWeight="Black" Foreground="#15803D"/>
                            <TextBox x:Name="TxtNuevoStock" Width="100" FontSize="18" FontWeight="Black" Padding="6,3"
                                     HorizontalContentAlignment="Center" Foreground="#15803D" KeyDown="TxtNuevoStock_KeyDown"/>
                        </StackPanel>

                        <!-- Botón Confirmar -->
                        <Button Content="✔ Guardar [Enter]" Click="BtnConfirmarStock_Click"
                                Background="#16A34A" Foreground="White" FontWeight="Bold" FontSize="13" Padding="14,8"
                                Cursor="Hand" VerticalAlignment="Bottom"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 3: Historial de Conteo de la Sesión -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,8" CornerRadius="10,10,0,0">
                    <DockPanel LastChildFill="True">
                        <TextBlock Text="ARTÍCULOS AUDITADOS EN ESTA SESIÓN:" FontSize="11" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtConteoSession" Text="(0 productos)" FontSize="11" Foreground="#94A3B8" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <DataGrid x:Name="GridSesion" Grid.Row="1"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9" RowHeight="36" FontSize="12"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Hora" Binding="{Binding HoraTexto}" Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Rubro" Binding="{Binding Rubro}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Código / SKU" Binding="{Binding SKU}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Artículo" Binding="{Binding Nombre}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Stock Anterior" Binding="{Binding StockAnterior, StringFormat='N0'}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Nuevo Stock" Binding="{Binding NuevoStock, StringFormat='N0'}" Width="100" FontWeight="Bold" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Variación" Binding="{Binding VariacionTexto}" Width="90" FontWeight="Bold" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 4: Pie de Página -->
        <DockPanel Grid.Row="4" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="💡 Cada producto auditado queda guardado permanentemente en la base de datos al instante." FontSize="11.5" Foreground="#64748B"/>
            </StackPanel>

            <Button DockPanel.Dock="Right" Content="Cerrar Auditoría [Esc]" Click="BtnCerrar_Click"
                    Background="#F1F5F9" Foreground="#334155" FontWeight="Bold" Padding="16,8" Cursor="Hand"/>
        </DockPanel>
    </Grid>
</Window>
