<Window x:Class="PuntoDeVentaLibreria.UI.Views.Login.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:PuntoDeVentaLibreria.UI.Converters"
        mc:Ignorable="d"
        Title="Acceso al Sistema - MR SYS Librería" 
        Height="560" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0F172A"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="380">
        <Border Background="White" CornerRadius="16" Padding="32,28" BorderBrush="#334155" BorderThickness="1">
            <StackPanel>
                <!-- Logo y Encabezado -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Border Background="#2563EB" CornerRadius="8" Padding="10,4" Margin="0,0,8,0">
                        <TextBlock Text="MR SYS" FontWeight="Black" Foreground="White" FontSize="16"/>
                    </Border>
                    <TextBlock Text="Librería &amp; Regalería" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="INICIAR SESIÓN" FontSize="18" FontWeight="Black" Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Ingrese sus credenciales para habilitar el punto de venta" 
                           FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>

                <!-- Selector de Usuarios Rápidos -->
                <TextBlock Text="Seleccionar Operador:" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding UsuariosDisponibles}" Margin="0,0,0,14">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding NombreCompleto}" 
                                    Command="{Binding DataContext.SeleccionarUsuarioCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Padding="10,6" Margin="0,0,6,6" FontSize="11" FontWeight="SemiBold"
                                    Background="#F1F5F9" Foreground="#334155" Cursor="Hand"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Campo Usuario -->
                <TextBlock Text="Usuario:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtUsuario" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                         FontSize="14" Padding="10,8" Margin="0,0,0,12" Background="#F8FAFC"/>

                <!-- Campo Contraseña / PIN -->
                <TextBlock Text="Contraseña o PIN:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                <PasswordBox x:Name="TxtPassword" FontSize="16" Padding="10,8" Margin="0,0,0,14" Background="#F8FAFC"/>

                <!-- Cartel de Error -->
                <Border x:Name="BorderError" Background="#FEF2F2" BorderBrush="#F87171" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,14"
                        Visibility="Collapsed">
                    <TextBlock Text="{Binding MensajeError}" Foreground="#DC2626" FontSize="11" FontWeight="Bold" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                </Border>

                <!-- Botón de Ingreso -->
                <Button x:Name="BtnIngresar" Content="🔑 Ingresar al Sistema [ENTER]" 
                        Click="BtnIngresar_Click"
                        Background="#2563EB" Foreground="White" FontSize="14" FontWeight="Bold"
                        Padding="16,12" Cursor="Hand" Margin="0,0,0,16"/>

                <!-- Ayuda de Credenciales Demo -->
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,8">
                    <TextBlock Text="💡 Demo: admin (clave: admin) o cajero (clave: 1234)" 
                               FontSize="11" Foreground="#64748B" TextAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
