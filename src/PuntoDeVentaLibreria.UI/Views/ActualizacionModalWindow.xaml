<Window x:Class="PuntoDeVentaLibreria.UI.Views.ActualizacionModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Actualización Oficial de Sistema" 
        Height="520" Width="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <Border Grid.Row="0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
            <DockPanel LastChildFill="True">
                <TextBlock Text="🚀" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="¡NUEVA VERSIÓN DISPONIBLE!" FontSize="16" FontWeight="Bold" Foreground="#1E3A8A"/>
                    <TextBlock Text="Hay una actualización oficial disponible para su terminal MR SYS." FontSize="12" Foreground="#3B82F6"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- COMPARATIVA DE VERSIONES -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Version Actual -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="VERSIÓN ACTUAL" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                    <Border Background="#F1F5F9" CornerRadius="6" Padding="10,4" Margin="0,4,0,0">
                        <TextBlock x:Name="TxtVersionActual" Text="v1.0.0" FontSize="14" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Flecha -->
                <TextBlock Grid.Column="1" Text="➜" FontSize="18" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="12,12,12,0"/>

                <!-- Version Nueva -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="NUEVA VERSIÓN" FontSize="10" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Center"/>
                    <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,4,0,0">
                        <TextBlock x:Name="TxtVersionDisponible" Text="v1.0.1" FontSize="14" FontWeight="Black" Foreground="#166534" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- NOVEDADES / NOTAS DE LANZAMIENTO -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="Novedades y mejoras incluidas:" FontSize="12" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,6"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TxtNotasLanzamiento" Text="Optimizaciones de rendimiento, mejoras en el sistema de tickets y correcciones de estabilidad." 
                               FontSize="12" Foreground="#475569" TextWrapping="Wrap" LineHeight="18"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- SEGURIDAD DE DATOS -->
        <Border Grid.Row="3" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,14">
            <DockPanel LastChildFill="True">
                <TextBlock Text="🛡️" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Seguridad garantizada: Sus ventas, clientes, stock y cobros no se verán afectados. Se realizará un respaldo automático previo." 
                           FontSize="11" Foreground="#166534" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- BARRA DE PROGRESO DE DESCARGA -->
        <StackPanel Grid.Row="4" x:Name="PanelProgreso" Visibility="Collapsed" Margin="0,0,0,14">
            <TextBlock x:Name="TxtEstadoProgreso" Text="Descargando actualización..." FontSize="12" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,0,0,4"/>
            <ProgressBar x:Name="ProgresoDescarga" Height="10" Minimum="0" Maximum="100" Value="0" Foreground="#2563EB" Background="#E2E8F0"/>
            <TextBlock x:Name="TxtDetalleBytes" Text="" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- MENSAJE DE ERROR SI OCURRE -->
        <TextBlock Grid.Row="4" x:Name="TxtError" Text="" Foreground="#DC2626" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8"/>

        <!-- BOTONES DE ACCIÓN -->
        <DockPanel Grid.Row="5">
            <Button x:Name="BtnMasTarde" Content="Más tarde" Click="BtnMasTarde_Click" 
                    Padding="16,8" FontSize="13" Background="#F1F5F9" Foreground="#475569" BorderBrush="#CBD5E1" Cursor="Hand"/>

            <Button x:Name="BtnActualizar" Content="⬇ Actualizar e Instalar Ahora" Click="BtnActualizar_Click" HorizontalAlignment="Right"
                    Background="#16A34A" Foreground="White" FontWeight="Bold" Padding="20,8" FontSize="13" Cursor="Hand"/>
        </DockPanel>
    </Grid>
</Window>
