<Window x:Class="PuntoDeVentaLibreria.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:PuntoDeVentaLibreria.UI.Converters"
        mc:Ignorable="d"
        Title="{Binding Titulo}"
        Height="720" Width="1200"
        MinHeight="580" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="content"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover sobre botón NO activo -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="Tag" Value="{x:Null}"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#CBD5E1"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </MultiTrigger>

                            <!-- Estado ACTIVO (seleccionado) -->
                            <Trigger Property="Tag" Value="Activo">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1D4ED8"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>

                            <!-- Hover sobre botón ACTIVO: Sigue azul profundo, texto blanco siempre legible -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="Tag" Value="Activo"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1E40AF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR / HEADER -->
        <Border Grid.Row="0" Background="#0F172A" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Marca & Sistema -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2563EB" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                        <TextBlock Text="MR SYS" Foreground="White" FontWeight="Black" FontSize="14"/>
                    </Border>
                    <TextBlock Text="{Binding Titulo}" Foreground="White" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Estado del Turno, Licencia y Actualización -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Botón Interactivo de Actualización si hay -->
                    <Button Margin="0,0,8,0" Padding="10,4" Cursor="Hand"
                            Command="{Binding AbrirActualizacionModalCommand}"
                            ToolTip="Haga clic para ver las novedades e instalar la actualización oficial"
                            Visibility="{Binding HayActualizacionDisponible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#FEF08A" BorderBrush="#FACC15" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🚀 v" FontWeight="Bold" Foreground="#854D0E" FontSize="11"/>
                                        <TextBlock Text="{Binding NuevaVersionTexto}" FontWeight="Bold" Foreground="#854D0E" FontSize="11"/>
                                        <TextBlock Text=" disponible (Clic aquí)" FontWeight="SemiBold" Foreground="#A16207" FontSize="11" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Badge Estado Caja -->
                    <Border Margin="0,0,8,0" Padding="10,4" CornerRadius="6" Background="{Binding ColorFondoEstadoCaja}">
                        <TextBlock Text="{Binding EstadoCajaTexto}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </Border>

                    <!-- Badge Licencia -->
                    <Border Margin="0,0,8,0" Padding="10,4" CornerRadius="6" Background="{Binding LicenciaBadgeColor}">
                        <TextBlock Text="{Binding LicenciaBadgeTexto}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </Border>

                    <!-- Usuario Activo -->
                    <Border Padding="10,4" CornerRadius="6" Background="#1E293B">
                        <TextBlock Text="{Binding UsuarioActivoTexto}" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5E1"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CUERPO PRINCIPAL CON BARRA LATERAL -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- BARRA LATERAL FLUENT -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="12">
                <StackPanel>
                    <!-- LOGO / COMERCIO -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Si tiene logo custom -->
                            <Border Width="34" Height="34" CornerRadius="6" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,8,0"
                                    Visibility="{Binding TieneLogoCustom, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Image Source="{Binding LogoRuta}" Stretch="Uniform" Margin="2" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>

                            <!-- Si NO tiene logo custom -->
                            <Border Background="#0F172A" CornerRadius="6" Width="34" Height="34" Margin="0,0,8,0"
                                    Visibility="{Binding TieneLogoCustom, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <TextBlock Text="📚" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel VerticalAlignment="Center" MaxWidth="140">
                                <TextBlock Text="{Binding NombreComercio}" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="#0F172A"/>
                                <TextBlock Text="LIBRERÍA &amp; REGALOS" FontSize="8.5" FontWeight="Bold" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Botones de Navegación -->
                    <Button x:Name="BtnNavPos" Content="🛍 Punto de Venta"
                            Style="{StaticResource NavButtonStyle}" Tag="Activo" Click="NavPos_Click"/>

                    <Button x:Name="BtnNavDashboard" Content="📊 Dashboard &amp; Reportes"
                            Style="{StaticResource NavButtonStyle}" Click="NavDashboard_Click"/>

                    <Button x:Name="BtnNavInventario" Content="📦 Stock / Útiles"
                            Style="{StaticResource NavButtonStyle}" Click="NavInventario_Click"/>

                    <Button x:Name="BtnNavCaja" Content="💵 Caja &amp; Turnos"
                            Style="{StaticResource NavButtonStyle}" Click="NavCaja_Click"/>

                    <Button x:Name="BtnNavClientes" Content="👥 Clientes / Cta Cte"
                            Style="{StaticResource NavButtonStyle}" Click="NavClientes_Click"/>

                    <Button x:Name="BtnNavConfiguracion" Content="⚙ Configuración"
                            Style="{StaticResource NavButtonStyle}" Click="NavConfiguracion_Click"/>

                    <Separator Margin="0,8,0,8"/>

                    <Button x:Name="BtnCerrarSesion" Content="🚪 Cambiar Usuario / Salir"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" Foreground="#991B1B"
                            Padding="12,10" FontSize="12" FontWeight="SemiBold" Cursor="Hand" Click="CerrarSesion_Click"/>
                </StackPanel>
            </Border>

            <!-- CONTENEDOR DINÁMICO DE PANTALLAS -->
            <ContentControl x:Name="MainContentControl" Grid.Column="1"/>
        </Grid>

        <!-- STATUS BAR INFERIOR -->
        <Border Grid.Row="2" Background="#0F172A" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusBarIzquierdaTexto}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusBarDerechaTexto}" Foreground="#F1F5F9" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
