<Window x:Class="PuntoDeVentaLibreria.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="MR SYS Retail - Punto de Venta Librería &amp; Regalería"
        Height="780" Width="1240"
        MinHeight="680" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR / HEADER -->
        <Border Grid.Row="0" Background="#0F172A" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Marca & Sistema -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2563EB" CornerRadius="8" Padding="10,6" Margin="0,0,12,0">
                        <TextBlock Text="MR SYS" Foreground="White" FontWeight="Black" FontSize="15"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="LIBRERÍA &amp; REGALERÍA" Foreground="White" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="Terminal de Mostrador y Útiles Escolares" Foreground="#94A3B8" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- Estado del Turno y Cajero -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Badge Caja Abierta -->
                    <Border Background="#064E3B" CornerRadius="16" Padding="12,4" Margin="0,0,16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0"/>
                            <TextBlock Text="CAJA ABIERTA" Foreground="#A7F3D0" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- Usuario -->
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding UsuarioActual}" Foreground="White" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        <TextBlock Text="Vendedora Mostrador" Foreground="#64748B" FontSize="10" HorizontalAlignment="Right"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CUERPO PRINCIPAL DEL TPV (2 Columnas) -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="65*"/>
                <ColumnDefinition Width="35*"/>
            </Grid.ColumnDefinitions>

            <!-- COLUMNA IZQUIERDA: LECTOR, TICKET Y COBRO (65%) -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- BARRA DE LECTURA ÓPTICA PERPETUA -->
                <Border Grid.Row="0" Background="White" CornerRadius="10" BorderBrush="#CBD5E1" BorderThickness="1.5" Padding="14,10" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="📷" FontSize="20" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="ESCANEAR [ENTER]:" FontSize="12" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBox x:Name="TxtCodigoBarras" Grid.Column="1"
                                 Text="{Binding CodigoBarrasInput, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="16" FontWeight="SemiBold" Padding="8,4"
                                 BorderThickness="1" BorderBrush="#94A3B8"
                                 VerticalAlignment="Center"/>

                        <Button Grid.Column="2" Content="Buscar / Enter" Command="{Binding EscanearCodigoCommand}"
                                Margin="10,0,0,0" Padding="14,6" FontWeight="Bold" Cursor="Hand"
                                Background="#2563EB" Foreground="White"/>
                    </Grid>
                </Border>

                <!-- GRILLA DEL TICKET EN CURSO -->
                <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,10">
                    <DataGrid ItemsSource="{Binding Items}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9"
                              RowHeight="46"
                              FontSize="13"
                              Background="White"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <!-- Código / SKU -->
                            <DataGridTextColumn Header="Código / SKU" Binding="{Binding SKU}" Width="120" IsReadOnly="True"/>

                            <!-- Descripción -->
                            <DataGridTemplateColumn Header="Descripción del Artículo / Útil" Width="*" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Descripcion}" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Cantidad con Controles +/- -->
                            <DataGridTemplateColumn Header="Cantidad" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button Content="-" Width="26" Height="26" Padding="0" FontWeight="Bold" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.DecrementarCantidadCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                            <TextBlock Text="{Binding Cantidad, StringFormat='N0'}" FontWeight="Bold" FontSize="14" Width="36" TextAlignment="Center" VerticalAlignment="Center"/>
                                            <Button Content="+" Width="26" Height="26" Padding="0" FontWeight="Bold" Margin="4,0,0,0"
                                                    Command="{Binding DataContext.IncrementarCantidadCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Precio Unitario -->
                            <DataGridTextColumn Header="P. Unitario" Binding="{Binding PrecioUnitario, StringFormat='${0:N2}'}" Width="100" IsReadOnly="True"/>

                            <!-- Subtotal -->
                            <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat='${0:N2}'}" Width="110" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Botón Quitar -->
                            <DataGridTemplateColumn Header="" Width="45">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="❌" Width="28" Height="28" Padding="0" Foreground="#EF4444"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                Command="{Binding DataContext.EliminarItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- BARRA DE ESTADO / MENSAJES -->
                <Border Grid.Row="2" Background="#E2E8F0" CornerRadius="6" Padding="12,6" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding MensajeEstado}" Foreground="#334155" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding NumeroComprobanteUltimaVenta, StringFormat='Última Venta: {0}'}" 
                                   Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- TARJETA DE TOTALES GIGANTE -->
                <Border Grid.Row="3" Background="#0F172A" CornerRadius="12" Padding="20,14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CantidadArticulos, StringFormat='Artículos en ticket: {0}'}" Foreground="#94A3B8" FontSize="12"/>
                            <TextBlock Text="{Binding SubtotalBruto, StringFormat='Subtotal: ${0:N2}'}" Foreground="#CBD5E1" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="TOTAL A COBRAR" Foreground="#38BDF8" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding TotalVenta, StringFormat='${0:N2}'}" Foreground="White" FontSize="36" FontWeight="Black" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- BOTONES DE ACCIÓN RÁPIDA / TECLADO -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="💰 [F2] COBRAR TICKET" Command="{Binding AbrirCobroCommand}"
                            Background="#16A34A" Foreground="White" FontSize="16" FontWeight="Bold"
                            Padding="20,12" Margin="0,0,8,0" Cursor="Hand"/>

                    <Button Grid.Column="1" Content="📝 [F4] Venta Manual" Command="{Binding AgregarVentaManualCommand}"
                            Background="#3B82F6" Foreground="White" FontSize="13" FontWeight="SemiBold"
                            Padding="16,12" Margin="0,0,8,0" Cursor="Hand"/>

                    <Button Grid.Column="2" Content="🗑 [F5] Limpiar" Command="{Binding LimpiarTicketCommand}"
                            Background="#DC2626" Foreground="White" FontSize="13" FontWeight="SemiBold"
                            Padding="16,12" Cursor="Hand"/>
                </Grid>
            </Grid>

            <!-- COLUMNA DERECHA: BOTONERA RÁPIDA TÁCTIL Y COMBOS (35%) -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cabecera Botonera -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,4">
                        <TextBlock Text="BOTONERA RÁPIDA &amp; KITS" FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="Fotocopias, impresiones y combos escolares sin código de barras" 
                               FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <!-- Lista de Botones Rápidos -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding BotonesRapidos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" 
                                            Padding="12,10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Nombre}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding CategoriaNombre}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <Button Grid.Column="1" Command="{Binding DataContext.AgregarBotonRapidoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#0284C7" Foreground="White" FontWeight="Bold"
                                                    Padding="12,6" Margin="8,0,0,0" Cursor="Hand" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PrecioVenta, StringFormat='${0:N2}'}"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Atajo de Teclado Info -->
                    <Border Grid.Row="3" Background="#F1F5F9" CornerRadius="8" Padding="10,6" Margin="0,8,0,0">
                        <TextBlock Text="💡 Tip: Haga clic en cualquier útil o servicio para agregarlo al ticket." FontSize="11" Foreground="#475569" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
